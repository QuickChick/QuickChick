DECLARE PLUGIN "coq-quickchick.plugin"

{
open Libnames
open Util
open Constrexpr
open Stdarg
open Error

type derivation =
  | Simple of [ `Gen | `Enum | `Simpl of SimplDriver.derivable ] list
  | Dependent of string (* scheduling mode: Gen, Enum or Check *)

let class_assoc_opts = [ ("GenSized"                 , Simple [`Gen])
                       ; ("EnumSized"                , Simple [`Enum])
                       ; ("Shrink"                   , Simple [`Simpl SimplDriver.Shrink])
                       ; ("Arbitrary"                , Simple [`Gen; `Simpl SimplDriver.Shrink])
                       ; ("Fuzzy"                    , Simple [`Simpl SimplDriver.Fuzzy])
                       ; ("Mutate"                   , Simple [`Simpl SimplDriver.Mutate])
                       ; ("Show"                     , Simple [`Simpl SimplDriver.Show])
                       ; ("Sized"                    , Simple [`Simpl SimplDriver.Sized])
                       ; ("DecOpt"                   , Dependent "Check")
                       ; ("ArbitrarySizedSuchThat"   , Dependent "Gen")
                       ; ("GenSizedSuchThat"         , Dependent "Gen")
                       ; ("EnumSizedSuchThat"        , Dependent "Enum")
                       ; ("Generator"                , Dependent "Gen")
                       ; ("Enumerator"               , Dependent "Enum")
                       ; ("Checker"                  , Dependent "Check")
                       ]

let class_assoc_table =
  let h = Hashtbl.create (List.length class_assoc_opts) in
  List.iter (fun (kwd, tok) -> Hashtbl.add h kwd tok) class_assoc_opts;
  h

let dispatch cn ind =
  let convert_reference_to_string c =
    match c with
    | {CAst.v = CRef (r, _) ; _} -> string_of_qualid r
    | _ -> failwith "Usage: QuickChick Derive <class_name> for <inductive_name>  OR  QuickChick Derive (<class_name>, ... , <class_name>) for <inductive_name>" in

  (* Class names may be a single reference or a tuple of references. *)
  let ss = match cn.CAst.v with
     | CNotation (_, _, ([a],[b],_,_)) ->
         let c = convert_reference_to_string a in
         let cs = List.map convert_reference_to_string b in
         c :: cs
     | _ -> [convert_reference_to_string cn]
  in

  let get_class_names s =
    try Hashtbl.find class_assoc_table s
    with Not_found ->
      failwith ( "Not a valid class name. Expected one of : " ^ (String.concat " , " (List.map fst class_assoc_opts)))
  in

  let class_names =
    match ss with
    | s::ss -> List.fold_left (fun der s ->
                               match der, get_class_names s with
                               | Simple ds1, Simple ds2 -> Simple (ds1 @ ds2)
                               | _ -> qcfail "Derive one dependent class at a time"
                              ) (get_class_names s) ss
    | _ -> qcfail "At least one class name expected" in

  match class_names with
  | Simple classes -> List.iter (function
      | `Gen -> PublicDerive.derive_simple ~enumerator:false ind
      | `Enum -> PublicDerive.derive_simple ~enumerator:true ind
      | `Simpl cn -> SimplDriver.derive cn ind) classes
  | Dependent mode -> PublicDerive.derive_dependent ~mode ind

let merge ind1 ind2 ind3 =
  MergeTypes.merge ind1 ind2 ind3

let merge_test ind1  =
  MergeTypes.merge_test ind1
}
  
VERNAC COMMAND EXTEND Merge CLASSIFIED AS SIDEFF
 | ["Merge" constr(ind1) "With" constr(ind2) "As" constr(ind)] ->
    { merge ind1 ind2 ind }
END

VERNAC COMMAND EXTEND MergeTest CLASSIFIED AS SIDEFF
 | ["MergeTest" constr(ind1)] ->
    { merge_test ind1 }
END

(* QuickChick Derive and QC Derive: prefixed so they do not clash with the
   Derive commands of Stdlib or Equations. *)
VERNAC COMMAND EXTEND QuickChickDerive CLASSIFIED AS SIDEFF
   | ["QuickChick" "Derive" constr(class_name) "for" constr(inductive)] ->
     { dispatch class_name inductive }
   | ["QC" "Derive" constr(class_name) "for" constr(inductive)] ->
     { dispatch class_name inductive }
END
