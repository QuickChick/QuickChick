DECLARE PLUGIN "coq-quickchick.plugin"

{
open Libnames
open Util
open Constrexpr
open Names
open Stdarg
open Error

type derivation = SimpleDer of SimplDriver.derivable list
                | DepDer of DepDriver.derivable

let simpl_dispatch ~legacy ind classes name1 name2 =
  List.iter (fun cn -> match legacy, cn with
    | false, SimplDriver.GenSized -> PublicDerive.derive_simple ~enumerator:false ind
    | false, SimplDriver.EnumSized -> PublicDerive.derive_simple ~enumerator:true ind
    | _ -> SimplDriver.derive cn ind name1 name2) classes

let class_assoc_opts = [ ("GenSized"                 , SimpleDer [SimplDriver.GenSized])
                       ; ("EnumSized"                , SimpleDer [SimplDriver.EnumSized])                       
                       ; ("Shrink"                   , SimpleDer [SimplDriver.Shrink])
                       ; ("Arbitrary"                , SimpleDer [SimplDriver.GenSized; SimplDriver.Shrink])
                       ; ("Fuzzy"                    , SimpleDer [SimplDriver.Fuzzy])
                       ; ("Mutate"                   , SimpleDer [SimplDriver.Mutate])
                       ; ("Show"                     , SimpleDer [SimplDriver.Show])
                       ; ("Sized"                    , SimpleDer [SimplDriver.Sized])
                       ; ("DecOpt"                   , DepDer DepDriver.DecOpt)
                       ; ("ArbitrarySizedSuchThat"   , DepDer DepDriver.GenSizedSuchThat)
                       ; ("GenSizedSuchThat"         , DepDer DepDriver.GenSizedSuchThat)                       
                       ; ("EnumSizedSuchThat"        , DepDer DepDriver.EnumSizedSuchThat)
                       ; ("Generator"                , DepDer DepDriver.GenSizedSuchThat)
                       ; ("Enumerator"               , DepDer DepDriver.EnumSizedSuchThat)
                       ; ("Checker"                  , DepDer DepDriver.DecOpt)
                       ]

let class_assoc_table =
  let h = Hashtbl.create (List.length class_assoc_opts) in
  List.iter (fun (kwd, tok) -> Hashtbl.add h kwd tok) class_assoc_opts;
  h

let dispatch_with ~legacy cn ind name1 name2 =
  let convert_reference_to_string c =
    match c with
    | {CAst.v = CRef (r, _) ; _} -> string_of_qualid r
    | _ -> failwith "Usage: QuickChick Derive <class_name> for <inductive_name>  OR  QuickChick Derive (<class_name>, ... , <class_name>) for <inductive_name>" in

  (* Class names may be a single reference or a tuple of references. *)
  let ss = match cn.CAst.v with
     | CNotation (_, _, ([a],[b],_,_)) ->
         let c = convert_reference_to_string a in
         let cs = List.map convert_reference_to_string b in
         c :: cs
     | _ -> [convert_reference_to_string cn]
  in

  let get_class_names s =
    try Hashtbl.find class_assoc_table s
    with Not_found -> begin
        (* TODO: Figure out how to pretty print in a failwith... *)
        failwith ( "Not a valid class name. Expected one of : " ^ (String.concat " , " (List.map fst class_assoc_opts)))
      end
  in

  let class_names =
    match ss with
    | s::ss -> List.fold_left (fun der s ->
                               match der, get_class_names s with
                               | SimpleDer ds1, SimpleDer ds2 -> SimpleDer (ds1 @ ds2)
                               | DepDer ds1, DepDer ds2 ->
                                  qcfail "Implement dependent derive for multiple classes"
                              ) (get_class_names s) ss
    | _ -> qcfail "At least one class name expected" in

  match class_names with
  | SimpleDer classes -> simpl_dispatch ~legacy ind classes name1 name2
  | DepDer class_name ->
      if legacy then DepDriver.dep_dispatch ind class_name else
      let mode = match class_name with
        | DepDriver.DecOpt -> "Check"
        | DepDriver.GenSizedSuchThat -> "Gen"
        | DepDriver.EnumSizedSuchThat -> "Enum" in
      PublicDerive.derive_dependent ~mode ind

let dispatch = dispatch_with ~legacy:false
let dispatch_legacy cn ind name1 name2 =
  PublicDerive.warn_legacy ();
  dispatch_with ~legacy:true cn ind name1 name2

let merge ind1 ind2 ind3 =
  MergeTypes.merge ind1 ind2 ind3

let merge_test ind1  =
  MergeTypes.merge_test ind1
}
  
VERNAC COMMAND EXTEND Merge CLASSIFIED AS SIDEFF
 | ["Merge" constr(ind1) "With" constr(ind2) "As" constr(ind)] ->
    { merge ind1 ind2 ind }
END

VERNAC COMMAND EXTEND MergeTest CLASSIFIED AS SIDEFF
 | ["MergeTest" constr(ind1)] ->
    { merge_test ind1 }
END

(* QuickChick Derive and QC Derive: prefixed so they do not clash with the
   Derive commands of Stdlib or Equations. *)
VERNAC COMMAND EXTEND QuickChickDerive CLASSIFIED AS SIDEFF
   | ["QuickChick" "Derive" constr(class_name) "for" constr(inductive)] ->
     { dispatch class_name inductive "" "" }
   | ["QuickChick" "Derive" constr(class_name) "for" constr(inductive) "using" ident(genInst)] ->
     { dispatch class_name inductive (Id.to_string genInst) ""}
   | ["QuickChick" "Derive" constr(class_name) "for" constr(inductive) "using" ident(genInst) "and" ident(monInst) ] ->
     { dispatch class_name inductive (Id.to_string genInst) (Id.to_string monInst)}
   | ["QC" "Derive" constr(class_name) "for" constr(inductive)] ->
     { dispatch class_name inductive "" "" }
   | ["QC" "Derive" constr(class_name) "for" constr(inductive) "using" ident(genInst)] ->
     { dispatch class_name inductive (Id.to_string genInst) ""}
   | ["QC" "Derive" constr(class_name) "for" constr(inductive) "using" ident(genInst) "and" ident(monInst) ] ->
     { dispatch class_name inductive (Id.to_string genInst) (Id.to_string monInst)}
END

VERNAC COMMAND EXTEND QuickChickDeriveLegacy CLASSIFIED AS SIDEFF
   | ["QuickChick" "Derive" "Legacy" constr(class_name) "for" constr(inductive)] ->
     { dispatch_legacy class_name inductive "" "" }
   | ["QuickChick" "Derive" "Legacy" constr(class_name) "for" constr(inductive) "using" ident(genInst)] ->
     { dispatch_legacy class_name inductive (Id.to_string genInst) "" }
   | ["QuickChick" "Derive" "Legacy" constr(class_name) "for" constr(inductive) "using" ident(genInst) "and" ident(monInst)] ->
     { dispatch_legacy class_name inductive (Id.to_string genInst) (Id.to_string monInst) }
   | ["QC" "Derive" "Legacy" constr(class_name) "for" constr(inductive)] ->
     { dispatch_legacy class_name inductive "" "" }
   | ["QC" "Derive" "Legacy" constr(class_name) "for" constr(inductive) "using" ident(genInst)] ->
     { dispatch_legacy class_name inductive (Id.to_string genInst) "" }
   | ["QC" "Derive" "Legacy" constr(class_name) "for" constr(inductive) "using" ident(genInst) "and" ident(monInst)] ->
     { dispatch_legacy class_name inductive (Id.to_string genInst) (Id.to_string monInst) }
END

VERNAC COMMAND EXTEND DeriveLegacy CLASSIFIED AS SIDEFF
   | ["DeriveLegacy" constr(class_name) "for" constr(inductive)] ->
     { dispatch_legacy class_name inductive "" "" }
   | ["DeriveLegacy" constr(class_name) "for" constr(inductive) "using" ident(genInst)] ->
     { dispatch_legacy class_name inductive (Id.to_string genInst) "" }
   | ["DeriveLegacy" constr(class_name) "for" constr(inductive) "using" ident(genInst) "and" ident(monInst)] ->
     { dispatch_legacy class_name inductive (Id.to_string genInst) (Id.to_string monInst) }
END
