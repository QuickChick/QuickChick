(* let is_binding_selection_valid i ((bindings,unbound) : bindings_and_unbound) =
  let is_binding_valid (v, ty, opt) =
    match opt with
    | None -> Some (v,ty,opt, Partial)
    | Some (DTyCtr (ind,_), i) ->
      (match final_density (ty_ctr_to_dep_dt ind) [i] false with
      | Checking -> None
      | d -> Some (v, ty, opt, d))
    | _ -> failwith "is_binding_selection_valid: Binding relation should have DTyCtr at toplevel" in
  match traverse is_binding_valid bindings with
  | None -> None
  | Some bs -> Some (i, (bs, unbound)) *)

(* Create a map from types * outputs => inductive_schedules which can be reused and referenced. *)

(** There will always exist at least one partial schedule for producers, b/c you can just arb all variables and check all hyps.*)

(* ScheduleRanking keeps only group combinations that can reach the best
   complete score. *)
and schedule_group_selector ds groups =
  let prefer_dense = ds = D_Gen || ds = D_Thm in
  ScheduleRanking.select_group_combinations ~prefer_dense (schedule_ranking_policy ())
    (score_group_candidates (schedule_density []) (fun _ scored ->
      Some (ScheduleRanking.group_features_of (scored_schedule_features ds 0 scored))) groups)

and constructor_valid_schedules (ind_name : ty_ctr) (ctr : rocq_ctr) (result_vars : (var * rocq_constr) list) (output_vars : var list) (ds : derive_sort) (opt : bool) =
  let (ctr_name, typ) = ctr in
  Error.msg_debug (str "Constructor name: " ++ str (constructor_to_string ctr_name) ++ fnl ());
  Error.msg_debug (str "Constructor type: " ++ str (rocq_constr_to_string typ) ++ fnl ());
  let typ = if opt then typ else arrows_to_products typ in
  let constructor_vars, _, _ = NewGenericLib.type_info typ in
  let known_inputs = List.map fst !schedule_inputs in
  let constructor_inputs = List.filter_map (fun (name, ty) ->
    if List.mem name known_inputs then None
    else Some (name, NewGenericLib.product_free_rocq_type_to_mexp ty)) constructor_vars in
  with_schedule_inputs (!schedule_inputs @ constructor_inputs) (fun () ->
  if Sys.getenv_opt "QC_POLICY_QUOTE_PROBE" = Some "1" then begin
    let view = match ScoringView.quote_term
      ~global:ScoringView.global_name (ScoringView.scope []) typ with
      | Ok (view, _) -> view
      | Error message -> failwith message in
    let env = Global.env () in
    ignore (GenericLib.interp_open_coq_expr env (Evd.from_env env)
      (ScoringView.term_expression view));
    let report = match Sys.getenv_opt "QC_POLICY_SCORE_PROBE" with
      | None -> "checked Rocq term view"
      | Some scorer ->
        (match ScoringView.evaluate env scorer view with
         | Error message -> failwith message
         | Ok (sigma, value, typ) ->
           match ScoringView.nat_of_value env sigma typ value with
           | Some n -> Printf.sprintf "Rocq score=%d" n
           | None -> "Rocq score=" ^
             Pp.string_of_ppcmds (Printer.pr_econstr_env env sigma value)) in
    Feedback.msg_notice (str ("[policy-quote] " ^ report))
  end;
  (* Each dependency derivation is a complete search with its own incumbent,
     so pruning applies at every nesting level. Only the experimental baseline
     comparison stays top-level. The bounds are for the density rankings;
     BudgetAware ranking has no pruning bounds yet, so it searches exhaustively. *)
  let score_pruning_mode = match !score_pruning_suspended,
    (if budget_aware_ranking () || cardinality_ranking () then None
     else Sys.getenv_opt "QC_SCHEDULE_SCORE_PRUNING") with
    | false, Some "baseline" -> `Baseline
    | _, Some ("1" | "true" | "yes") -> `Prune
    | _, Some "verify" -> `Verify
    | _ -> `Off in
  let prefer_dense = ds = D_Gen || ds = D_Thm in
  let policy = schedule_ranking_policy () in
  let reuse_stable = reuse_stable_entries () in
  let initial_inductive_memo = !density_inductive_memo in
  let stable_dependencies = stable_density_entries in
  (* Share only completed entries whose dependency walk read no provisional
     or cycle-dependent grade. Keep the caller's in-progress entries intact. *)
  let add_stable memo = if not reuse_stable then memo else with_stable_entries memo in
  let collect_stable () = if reuse_stable then
    InductiveScheduleKeyMap.iter (fun key entry -> match entry with
      | DensityDone (_, true, _) when
          not (InductiveScheduleKeyMap.mem key initial_inductive_memo) ->
        stable_dependencies := InductiveScheduleKeyMap.add key entry !stable_dependencies
      | _ -> ()) !density_inductive_memo in
  let incumbent = ref None in
  let observed_leaf_scores = ref [] in
  let observed_bounds = ref [] in
  let scored_leaves = ref 0 in
  let checked_prefixes = ref 0 in
  let pruned_prefixes = ref 0 in
  let trace_bounds = schedule_trace_enabled () &&
    Sys.getenv_opt "QC_SCHEDULE_TRACE_BOUNDS" = Some "1" in
  let trace_score kind path (score : ScheduleRanking.features) =
    if trace_bounds then Feedback.msg_notice (str (Printf.sprintf
      "[schedule-bound-detail] kind=%s path=%s density=%d counts=%s uses=%d\n"
      kind (String.concat "," (List.map (fun (i, _) -> string_of_int i) path))
      score.ScheduleRanking.density_rank
      (ScheduleRanking.histogram_to_string score.ScheduleRanking.density_counts)
      score.ScheduleRanking.variable_uses)) in
  let bound_grade_cache = Hashtbl.create 32 in
  let leaf_score_cache = Hashtbl.create 32 in
  let mode_grade_cache = Hashtbl.create 32 in
  let bound_cache_hits = ref 0 in
  let bound_cache_misses = ref 0 in
  let leaf_cache_hits = ref 0 in
  let mode_cache_hits = ref 0 in
  let bound_cpu = ref 0. in
  let leaf_cpu = ref 0. in
  let final_cpu = ref 0. in
  let timed total f =
    let before = Sys.time () in
    Fun.protect ~finally:(fun () -> total := !total +. Sys.time () -. before) f in
  let rec path_prefix prefix path = match prefix, path with
    | [], _ -> true
    | x :: xs, y :: ys when x = y -> path_prefix xs ys
    | _ -> false in
  let materialize ((steps, sort), ms, eqs) =
    let match_steps = List.map (fun (v,p) -> S_Match (v,p)) ms in
    match_steps, (List.map check_eq eqs @ steps, sort) in
  (* schedule_density traverses steps in sorted order. Equal multisets thus
     share mode grades within this constructor's fixed recursion context;
     restore each candidate's order for variable-use scoring. Duplicate steps
     are scored afresh because their occurrence grades need not be identical. *)
  let score_schedule ~use_cache neutral_steps ((steps, sort) as schedule) =
    if score_pruning_mode = `Off then schedule_density neutral_steps schedule else
    let ordered = List.sort Stdlib.compare steps in
    let cacheable = List.length ordered =
      List.length (List.sort_uniq Stdlib.compare ordered) in
    let key = ordered, sort in
    match (if use_cache && cacheable then Hashtbl.find_opt mode_grade_cache key
           else None) with
    | Some canonical ->
      incr mode_cache_hits;
      let neutral = match ds with
        | D_Gen | D_Thm -> Total | D_Check | D_Enum -> Checking in
      (List.map (fun step -> step, neutral) neutral_steps @
       List.map (fun step -> step, List.assoc step canonical) steps), sort
    | None ->
      let scored = schedule_density neutral_steps schedule in
      if cacheable then begin
        let graded_steps = List.filteri
          (fun i _ -> i >= List.length neutral_steps) (fst scored) in
        let canonical = List.sort (fun (left, _) (right, _) ->
          Stdlib.compare left right) graded_steps in
        (match Hashtbl.find_opt mode_grade_cache key with
         | Some previous when score_pruning_mode = `Verify &&
             previous <> canonical ->
           failwith "same step multiset received different dependency grades"
         | _ -> ());
        Hashtbl.replace mode_grade_cache key canonical
      end;
      scored in
  let leaf_score triple = timed leaf_cpu (fun () -> with_candidate_density_state (fun () ->
    let match_steps, schedule = materialize triple in
    let scored = score_schedule ~use_cache:(score_pruning_mode = `Prune && reuse_stable)
      match_steps schedule in
    Hashtbl.replace leaf_score_cache triple scored;
    scored_schedule_features ds 0 scored)) in
  let bound_score check_floor triple = timed bound_cpu (fun () -> with_candidate_density_state (fun () ->
    let match_steps, (steps, sort) = materialize triple in
    let neutral = match ds with
      | D_Gen | D_Thm -> Total
      | D_Check | D_Enum -> Checking in
    let known_grades =
      List.map (fun _ -> Some (density_rank neutral)) match_steps @
      List.map (fun step ->
        match fixed_step_density ds step with
        | Some grade -> Some (density_rank grade)
        | None ->
          (match Hashtbl.find_opt bound_grade_cache (step, sort) with
           | Some cached -> incr bound_cache_hits; cached
           | None ->
             incr bound_cache_misses;
             let before = !density_uncertainty_events in
             let scored = schedule_density [] ([step], sort) in
             let grade = match scored with
               | ([( _, grade)], _) when !density_uncertainty_events = before ->
                 Some (density_rank grade)
               | _ -> None in
             Hashtbl.add bound_grade_cache (step, sort) grade;
             grade)) steps @
      (* Remaining positive hypotheses with all arguments bound must become
         checks, whose fixed density rank is Checking = 0. *)
      List.init check_floor.NewGenericLib.forced_checks (fun _ -> Some 0) in
    let annotations = List.map (fun step -> step, Total) (match_steps @ steps) in
    (* Variables bound by a committed step stay bound, so their occurrences in
       the fully bound arguments of remaining hypotheses will be counted. *)
    let step_bound = List.fold_left (fun env (step, density) ->
      add_bound_vars env step density) [] annotations in
    let future_uses = List.length (List.filter (fun v -> List.mem_assoc v step_bound)
      check_floor.NewGenericLib.bound_argument_occurrences)
      + check_floor.NewGenericLib.future_variable_uses in
    ScheduleRanking.prefix_bound ~prefer_dense ~known_grades
      ~variable_uses:(get_num_var_uses (annotations, sort) ds + future_uses))) in
  let on_prefix = if score_pruning_mode = `Baseline then
    Some (fun _ terminal _ -> if terminal then incr scored_leaves)
  else None in
  let on_prefix_with_floor = if score_pruning_mode = `Prune ||
    score_pruning_mode = `Verify then Some (fun path terminal _ triple ->
    if terminal then begin
      incr scored_leaves;
      let score = try Some (leaf_score triple) with
        | Noninductive_dependency _ | Unavailable_mode _ -> None in
      Option.iter (fun score ->
        trace_score "leaf" path score;
        if score_pruning_mode = `Verify then
          observed_leaf_scores := score :: !observed_leaf_scores;
        if score_pruning_mode = `Verify then
          List.iter (fun (ancestor, bound) ->
            if path_prefix ancestor path &&
               ScheduleRanking.can_prune ~prefer_dense policy
                 ~incumbent:score ~bound then
              failwith "schedule score prefix bound exceeded a completed descendant")
            !observed_bounds;
        incumbent := Some (match !incumbent with
          | None -> score
          | Some best when ScheduleRanking.compare ~prefer_dense policy score best < 0 -> score
          | Some best -> best)) score
    end) else None in
  let should_prune_prefix_with_floor = if score_pruning_mode = `Verify || score_pruning_mode = `Prune then Some (fun path check_floor triple ->
    incr checked_prefixes;
    if score_pruning_mode = `Verify then begin
      let bound = try Some (bound_score check_floor triple) with
        | Noninductive_dependency _ | Unavailable_mode _ -> None in
      Option.iter (fun bound ->
        trace_score "bound" path bound;
        observed_bounds := (path, bound) :: !observed_bounds) bound;
      false
    end else match !incumbent with
      | None -> false
      | Some best ->
        (match try Some (bound_score check_floor triple) with
          | Noninductive_dependency _ | Unavailable_mode _ -> None with
        | None -> false
        | Some bound ->
          trace_score "bound" path bound;
          let cut = ScheduleRanking.can_prune_after ~prefer_dense policy
            ~incumbent:best ~bound in
          if cut then incr pruned_prefixes;
          cut)) else None in
  let group_mode = schedule_group_mode () in
  let prepared_inputs = ref [] in
  (* Prefix-pruning modes still search jointly. Under BudgetAware ranking,
     groups are scored and combined by BudgetAware itself, which is separable
     across footprint-disjoint groups. The unifier reports prepared inputs
     before it searches. *)
  let select_groups = if group_mode = `Off || score_pruning_mode <> `Off then None
    else if cardinality_ranking () then Some (fun groups ->
      let context = cardinality_context (cardinality_recursive_count result_vars output_vars) in
      GroupedScore.select_combinations CardinalityScore.group_policy
        (score_group_candidates (schedule_density []) (fun (steps, _) _ ->
          Some (CardinalityScore.score_schedule context steps)) groups))
    else if budget_aware_ranking () then Some (fun groups ->
      let context = budget_context !prepared_inputs in
      let key = budget_key ind_name result_vars output_vars ds in
      GroupedScore.select_combinations BudgetAwareScore.group_policy
        (score_group_candidates (schedule_density []) (fun (steps, _) _ ->
          Result.to_option (BudgetAwareScore.score_schedule context key steps)) groups))
    else Some (schedule_group_selector ds) in
  let schedule_matches = NewUnifyQC.type_to_schedules
    ~on_prepared:(fun inputs -> prepared_inputs := inputs) ?select_groups
    ?on_prefix ?on_prefix_with_floor ?should_prune_prefix_with_floor
    typ (Some ind_name) (Some ctr_name)
    result_vars output_vars ds opt in
  if score_pruning_mode <> `Off && schedule_trace_enabled () then
    Feedback.msg_notice (str (Printf.sprintf
      "[schedule-pruning] constructor=%s mode=%s prefixes=%d leaves=%d cuts=%d\n"
      (constructor_to_string ctr_name)
      (match score_pruning_mode with `Prune -> "prune" | `Verify -> "verify"
       | `Baseline -> "baseline" | `Off -> "off")
      !checked_prefixes !scored_leaves !pruned_prefixes));
  let schedules = List.mapi (fun i triple ->
    let ms_steps, schd = materialize triple in
    i, triple, ms_steps, schd) schedule_matches in
  (match Sys.getenv_opt "QC_POLICY_STEP_PROBE", schedules with
   | Some scorer, (_, _, _, (steps, _)) :: _ ->
     let names = List.map fst result_vars @
       List.concat_map ScoringView.step_variables steps
       |> List.sort_uniq Stdlib.compare in
     let scope = ScoringView.scope names in
     let finite_pins = BudgetAwareScore.finite_pins_from_environment () in
     List.iteri (fun index step ->
       let expression = match ScoringView.step_expression
         ~global:ScoringView.global_name ~finite_pins scope step with
         | Ok expression -> expression
         | Error message -> failwith message in
       match ScoringView.evaluate_expression (Global.env ()) scorer expression with
       | Error message -> failwith message
       | Ok (sigma, value, _) ->
         Feedback.msg_notice (str (Printf.sprintf
           "[policy-step] step=%d score=%s" index
           (Pp.string_of_ppcmds
             (Printer.pr_econstr_env (Global.env ()) sigma value))))) steps
   | _ -> ());
  let distinct_step_multisets = if not (schedule_trace_enabled ()) then 0 else
    schedules
    |> List.map (fun (_, _, _, (steps, sort)) ->
         List.sort Stdlib.compare steps, sort)
    |> List.sort_uniq Stdlib.compare
    |> List.length in
  let initial_density_memo = !density_memo in
  let schedule_densities = timed final_cpu (fun () -> Fun.protect
    ~finally:(fun () ->
      density_inductive_memo := initial_inductive_memo;
      density_memo := initial_density_memo)
    (fun () ->
    let entries = List.filter_map (fun (i, triple, ms_steps, schd) ->
      density_inductive_memo := add_stable initial_inductive_memo;
      density_memo := initial_density_memo;
      let scored = try Some (match score_pruning_mode,
        Hashtbl.find_opt leaf_score_cache triple with
        | `Prune, Some cached -> incr leaf_cache_hits; cached
        | _ -> with_score_pruning_suspended (fun () ->
            score_schedule ~use_cache:(score_pruning_mode = `Baseline && reuse_stable)
              ms_steps schd)) with
        | Noninductive_dependency _ | Unavailable_mode _ -> None in
      match scored with
      | None -> None
      | Some scored ->
        collect_stable ();
        let inductive_memo = !density_inductive_memo in
        let density_memo_after = !density_memo in
        if are_schedule_steps_valid i scored then
          Some (i, scored, inductive_memo, density_memo_after)
        else None) schedules in
    (* Ranking needs only the cached annotations. Recompute the winner to
       recover its dependency memo for code generation, and check its score. *)
    if score_pruning_mode <> `Prune &&
       (score_pruning_mode <> `Baseline || not reuse_stable) then entries else
      let better a b =
        let (i, scored, _, _) = a in
        let (j, other, _, _) = b in
        ScheduleRanking.compare ~prefer_dense policy
          (scored_schedule_features ds i scored)
          (scored_schedule_features ds j other) < 0 in
      let best = List.fold_left (fun best entry -> match best with
        | None -> Some entry
        | Some previous -> Some (if better entry previous then entry else previous))
        None entries in
      match best with
      | None -> entries
      | Some (best_id, cached, _, _) ->
        let (_, _, ms_steps, schd) =
          List.find (fun (i, _, _, _) -> i = best_id) schedules in
        density_inductive_memo := add_stable initial_inductive_memo;
        density_memo := initial_density_memo;
        let rescored = with_score_pruning_suspended (fun () ->
          schedule_density ms_steps schd) in
        collect_stable ();
        if scored_schedule_features ds best_id cached <>
           scored_schedule_features ds best_id rescored then
          failwith "cached leaf score differs from selected candidate scoring";
        let best_entry = (best_id, rescored, !density_inductive_memo,
                          !density_memo) in
        List.map (fun ((i, _, _, _) as entry) ->
          if i = best_id then best_entry else entry) entries)) in
  if group_mode = `Verify && select_groups <> None then begin
    let joint = NewUnifyQC.type_to_schedules typ (Some ind_name) (Some ctr_name)
      result_vars output_vars ds opt in
    (* Every grouped candidate must be an ordering the joint search admits
       when it does not merge swap-equivalent orderings. *)
    let unreduced =
      let previous = Sys.getenv_opt "QC_SCHEDULE_POR" in
      Unix.putenv "QC_SCHEDULE_POR" "0";
      Fun.protect ~finally:(fun () ->
        Unix.putenv "QC_SCHEDULE_POR" (Stdlib.Option.value ~default:"" previous))
        (fun () -> NewUnifyQC.type_to_schedules typ (Some ind_name) (Some ctr_name)
          result_vars output_vars ds opt) in
    (* Conversion and unification draw fresh names from global counters;
       compare schedules up to a consistent renaming of generated identifiers
       (v..N_ and unkn_N_), by first occurrence. *)
    let canonical (schedule, ms, eqs) =
      let text = NewUnifyQC.match_schedule_to_string schedule ms eqs in
      let names = Hashtbl.create 8 in
      let ident c = c = '_' || ('a' <= c && c <= 'z') || ('A' <= c && c <= 'Z')
                    || ('0' <= c && c <= '9') in
      let generated w =
        let n = String.length w in
        let digit i = i >= 0 && '0' <= w.[i] && w.[i] <= '9' in
        n >= 3 && w.[n - 1] = '_' && digit (n - 2) &&
        (w.[0] = 'v' || String.starts_with ~prefix:"unkn_" w) in
      let out = Buffer.create (String.length text) in
      let rec scan i =
        if i < String.length text then
          if ident text.[i] then begin
            let j = ref i in
            while !j < String.length text && ident text.[!j] do incr j done;
            let w = String.sub text i (!j - i) in
            Buffer.add_string out (if not (generated w) then w else
              match Hashtbl.find_opt names w with
              | Some n -> n
              | None ->
                let n = Printf.sprintf "#%d" (Hashtbl.length names) in
                Hashtbl.add names w n; n);
            scan !j
          end else (Buffer.add_char out text.[i]; scan (i + 1)) in
      scan 0;
      Buffer.contents out in
    let unreduced_canonical = List.map canonical unreduced in
    List.iter (fun triple ->
      if not (List.mem (canonical triple) unreduced_canonical) then
        (failwith ("grouped schedule search produced a schedule outside the joint search for constructor "
          ^ constructor_to_string ctr_name ^ "\n grouped: " ^ canonical triple
          ^ String.concat "" (List.map (fun t -> "\n joint: " ^ t) unreduced_canonical)))) schedule_matches;
    let scored_joint = with_temporary_density_state (fun () ->
      List.mapi (fun i triple ->
        density_inductive_memo := initial_inductive_memo;
        density_memo := initial_density_memo;
        let ms_steps, schd = materialize triple in
        try Some (i, triple, scored_schedule_features ds i (schedule_density ms_steps schd))
        with Noninductive_dependency _ | Unavailable_mode _ -> None) joint
      |> List.filter_map Fun.id) in
    let scored_grouped = List.map (fun (i, scored, _, _) ->
      let _, triple, _, _ = List.find (fun (j, _, _, _) -> i = j) schedules in
      i, triple, scored_schedule_features ds i scored) schedule_densities in
    let best entries = List.fold_left (fun best ((_, _, f) as entry) ->
      match best with
      | Some (_, _, g) when ScheduleRanking.compare ~prefer_dense policy g f <= 0 -> best
      | _ -> Some entry) None entries in
    let without_id (f : ScheduleRanking.features) = { f with ScheduleRanking.candidate_id = 0 } in
    let budget_verify () =
      let context = budget_context !prepared_inputs in
      let key = budget_key ind_name result_vars output_vars ds in
      let score steps = match BudgetAwareScore.score_schedule context key steps with
        | Ok score -> Some score | Error _ -> None in
      let best_budget = List.fold_left (fun best score -> match best, score with
        | _, None -> best
        | Some b, Some s when BudgetAwareScore.compare b s <= 0 -> best
        | _, Some s -> Some s) None in
      let joint_best = with_temporary_density_state (fun () -> best_budget
        (List.map (fun triple ->
          density_inductive_memo := initial_inductive_memo;
          density_memo := initial_density_memo;
          let ms_steps, schd = materialize triple in
          try score (List.map fst (fst (schedule_density ms_steps schd)))
          with Noninductive_dependency _ | Unavailable_mode _ -> None) joint)) in
      let grouped_best = with_temporary_density_state (fun () -> best_budget
        (List.map (fun (_, (steps, _), inductive_memo, density_memo_after) ->
          density_inductive_memo := inductive_memo;
          density_memo := density_memo_after;
          score (List.map fst steps)) schedule_densities)) in
      let same = match joint_best, grouped_best with
        | None, None -> true
        | Some j, Some g -> BudgetAwareScore.compare j g = 0
        | _ -> false in
      if not same then failwith ("grouped schedule search changed the best BudgetAware score for constructor "
        ^ constructor_to_string ctr_name ^ ": joint "
        ^ Stdlib.Option.fold ~none:"none" ~some:BudgetAwareScore.to_string joint_best
        ^ ", grouped "
        ^ Stdlib.Option.fold ~none:"none" ~some:BudgetAwareScore.to_string grouped_best) in
    let changed_selection = if budget_aware_ranking () then (budget_verify (); None) else
      match best scored_joint, best scored_grouped with
      | None, None -> None
      | Some (_, joint_triple, j), Some (_, grouped_triple, g) ->
        if ScheduleRanking.compare ~prefer_dense policy (without_id j) (without_id g) <> 0 then
          (let show (f : ScheduleRanking.features) ((steps, _), ms, eqs) =
             Printf.sprintf "density=%d counts=%s uses=%d steps=%s" f.ScheduleRanking.density_rank
               (ScheduleRanking.histogram_to_string f.ScheduleRanking.density_counts)
               f.ScheduleRanking.variable_uses
               (String.concat " ; " (List.map schedule_step_to_string steps)) in
           failwith ("grouped schedule search changed the best score for constructor "
            ^ constructor_to_string ctr_name ^ "\n joint: " ^ show j joint_triple
            ^ "\n grouped: " ^ show g grouped_triple));
        if canonical joint_triple = canonical grouped_triple then None
        else Some (canonical joint_triple, canonical grouped_triple)
      | _ -> failwith ("grouped schedule search changed candidate availability for constructor "
            ^ constructor_to_string ctr_name) in
    match Sys.getenv_opt "QC_SCHEDULE_GROUPS_LOG" with
    | None -> ()
    | Some path ->
      let oc = open_out_gen [Open_append; Open_creat] 0o644 path in
      Printf.fprintf oc "%s\t%s\t%s\tjoint=%d\tgrouped=%d\tsame_selection=%b\n"
        (ty_ctr_to_string ind_name) (constructor_to_string ctr_name)
        (schedule_rank_derive_sort_to_string ds)
        (List.length joint) (List.length schedule_matches) (changed_selection = None);
      Stdlib.Option.iter (fun (joint_text, grouped_text) ->
        Printf.fprintf oc "  joint selection:\n%s\n  grouped selection:\n%s\n"
          joint_text grouped_text) changed_selection;
      close_out oc
  end;
  (match Sys.getenv_opt "QC_BUDGET_AWARE_DEMO" with
   | Some target when target <> "" &&
       String.ends_with ~suffix:target (ty_ctr_to_string ind_name) ->
     let module B = BudgetAwareScore in
     let finite_pins = B.finite_pins_from_environment () in
     let rec selected_dependency memo seen request =
       let key = request.B.key in
       if List.mem key seen then None else
       let entry = match InductiveScheduleKeyMap.find_opt
         (key.B.relation, key.B.output_indices, key.B.derive_sort, true) memo with
         | Some entry -> Some entry
         | None -> InductiveScheduleKeyMap.find_opt
             (key.B.relation, key.B.output_indices, key.B.derive_sort, false) memo in
       match entry with
       | Some (DensityDone (((_, inputs, _, base, recursive), _), true, _)) ->
         (match base @ recursive with
          | [((steps, _), _, _)] ->
            let dependencies = B.required_dependencies key steps in
            let resolved = List.map (fun dependency ->
              dependency, selected_dependency memo (key :: seen) dependency)
              dependencies in
            if List.exists (fun (_, score) -> score = None) resolved then None
            else
              let context : B.context = {
                B.input_vars = List.map fst inputs;
                B.finite_pins = finite_pins;
                B.completed_dependency = (fun dependency ->
                  match List.assoc_opt dependency resolved with
                  | Some score -> score | None -> None) } in
              (match B.score_schedule context key steps with
               | Ok score -> Some score | Error _ -> None)
          | _ -> None)
       | _ -> None in
     let output_indices = List.mapi (fun i (name, _) -> i, name) result_vars
       |> List.filter_map (fun (i, name) ->
            if List.mem name output_vars then Some i else None) in
     let key : B.key = { relation = ind_name; output_indices; derive_sort = ds } in
     let complete = ref [] in
     List.iter (fun (id, _, memo, _) ->
       let _, triple, _, _ = List.find (fun (candidate_id, _, _, _) ->
         candidate_id = id) schedules in
       let dependencies = B.required_candidate_dependencies key triple in
       let resolved = List.map (fun dependency ->
         dependency, selected_dependency memo [key] dependency) dependencies in
       if List.exists (fun (_, score) -> score = None) resolved then
         Feedback.msg_notice (str (Printf.sprintf
           "[budget-aware] constructor=%s candidate=%d unavailable: unresolved dependency score"
           (constructor_to_string ctr_name) id))
       else
         let context : B.context = {
           B.input_vars = !prepared_inputs;
           B.finite_pins = finite_pins;
           B.completed_dependency = (fun dependency ->
             match List.assoc_opt dependency resolved with
             | Some score -> score | None -> None) } in
         match B.score_candidate context key triple with
         | Ok score ->
           complete := (id, score) :: !complete;
           Feedback.msg_notice (str (Printf.sprintf
             "[budget-aware] constructor=%s candidate=%d %s\n  steps: %s"
             (constructor_to_string ctr_name) id (B.to_string score)
             (B.candidate_steps triple |> List.map schedule_step_to_string
              |> String.concat " ; ")))
         | Error message ->
           Feedback.msg_notice (str (Printf.sprintf
             "[budget-aware] constructor=%s candidate=%d unavailable: %s"
             (constructor_to_string ctr_name) id message))) schedule_densities;
     if !complete <> [] && List.length !complete = List.length schedule_densities then begin
       let ordered = List.sort (fun (left, _) (right, _) ->
         Stdlib.compare left right) !complete in
       let best_id, _ = List.fold_left (fun ((best_id, best_score) as best)
         (id, score) ->
           if B.compare score best_score < 0 then id, score else best)
         (List.hd ordered) (List.tl ordered) in
       let selected = select_best_schedule
         (List.map (fun (id, scored, _, _) -> id, scored) schedule_densities)
         ds in
       Feedback.msg_notice (str (Printf.sprintf
         "[budget-aware] constructor=%s best=%d built-in-selected=%s"
         (constructor_to_string ctr_name) best_id
         (match selected with None -> "none" | Some (id, _, _) -> string_of_int id)))
     end
   | _ -> ());
  let policy_finite_pins = lazy (BudgetAwareScore.finite_pins_from_environment ()) in
  let policy_schedule_expression (steps, sort) =
     let result = match sort with
       | ProducerSchedule (_, _, result) | TheoremSchedule (result, _) ->
         Some result
       | CheckerSchedule -> None in
     let names = List.map fst result_vars @
       List.concat_map (fun (step, _) -> ScoringView.step_variables step) steps @
       (match result with None -> [] | Some term -> ScoringView.free_vars_term term)
       |> List.sort_uniq Stdlib.compare in
     let scope = ScoringView.scope names in
     let grade_expression = function
       | Checking -> ScoringView.constructor "Checking" []
       | Backtracking -> ScoringView.constructor "Backtracking" []
       | Neutral -> ScoringView.constructor "Neutral" []
       | Partial -> ScoringView.constructor "Partial" []
       | Total -> ScoringView.constructor "Total" [] in
     let expression = match ScoringView.schedule_expression
       ~global:ScoringView.global_name
       ~finite_pins:(Lazy.force policy_finite_pins)
       ~grade_expression scope steps result with
       | Ok expression -> expression
       | Error message -> failwith message in
     expression in
  (match Sys.getenv_opt "QC_POLICY_SCHEDULE_PROBE",
    Sys.getenv_opt "QC_POLICY_COMPARE_PROBE", schedule_densities with
   | Some scorer, None, (_, schedule, _, _) :: _ ->
     (match ScoringView.evaluate_expression (Global.env ()) scorer
       (policy_schedule_expression schedule) with
      | Error message -> failwith message
      | Ok (sigma, value, _) ->
        Feedback.msg_notice (str ("[policy-schedule] score=" ^
          Pp.string_of_ppcmds
            (Printer.pr_econstr_env (Global.env ()) sigma value))))
   | Some scorer, Some comparator, _ :: _ ->
     let env = Global.env () in
     let sigma = ref (Evd.from_env env) in
     let scores = List.map (fun (id, schedule, _, _) ->
       match ScoringView.evaluate_expression_in env !sigma scorer
         (policy_schedule_expression schedule) with
       | Error message -> failwith message
       | Ok (next_sigma, value, _) ->
         sigma := next_sigma;
         id, value) schedule_densities in
     if List.length scores > 1 then
       Feedback.msg_notice (str ("[policy-compare] values=" ^
         String.concat "; " (List.map (fun (id, value) ->
           Printf.sprintf "%d:%s" id
             (Pp.string_of_ppcmds (Printer.pr_econstr_env env !sigma value)))
           scores)));
     let orders = ref [] in
     let best = List.fold_left (fun best (id, value) -> match best with
       | None -> Some (id, value)
       | Some (_, best_value) as current ->
         (match ScoringView.compare_values env !sigma comparator value best_value with
          | Error message -> failwith message
          | Ok (next_sigma, order) ->
            sigma := next_sigma;
            orders := order :: !orders;
            if order < 0 then Some (id, value) else current)) None scores in
     (match best with
      | None -> assert false
      | Some (id, _) ->
        let count order = List.length (List.filter ((=) order) !orders) in
        Feedback.msg_notice (str (Printf.sprintf
          "[policy-compare] candidates=%d best=%d lt=%d eq=%d gt=%d"
          (List.length scores) id (count (-1)) (count 0) (count 1))))
   | None, Some _, _ ->
     failwith "SchedulingPolicy: comparator probe requires a scorer probe"
   | _ -> ());
  (match Sys.getenv_opt "QC_POLICY_RECORD_PROBE",
    Sys.getenv_opt "QC_POLICY_RECORD_PENDING_PROBE" with
   | None, None -> ()
   | Some _, Some _ ->
     failwith "SchedulingPolicy: choose one record probe"
   | (Some scorer, None) | (None, Some scorer) ->
     let include_pending = Sys.getenv_opt "QC_POLICY_RECORD_PENDING_PROBE" <> None in
     let record_label = if include_pending then "policy-record-pending"
       else "policy-record" in
     let collect_dependencies steps =
       let rec collect acc = function
         | [] -> Some (List.rev acc)
         | (step, _) :: rest ->
           (match step with
            | S_Match _ | S_Let _ -> collect acc rest
            | S_UC (_, (SrcRec _ | SrcMutrec _ | SrcDef _), _)
            | S_ST (_, (SrcRec _ | SrcMutrec _ | SrcDef _), _)
            | S_Check ((SrcRec _ | SrcMutrec _ | SrcDef _), _) -> None
            | _ ->
              let request = match step with
                | S_UC (_, SrcNonrec (DTyParam _ as parameter), ps) ->
                  Some (parameter, [], producer_sort_to_derive_sort ps, false)
                | _ -> schedule_step_dependence step in
              match request with
              | None -> None
              | Some ((relation, indices, mode, constrained) as request) ->
                let args = match relation with
                  | DTyCtr (_, args) | DNot (DTyCtr (_, args)) -> args
                  | _ -> [] in
                let outputs = List.filteri
                  (fun index _ -> List.mem index indices) args
                  |> List.concat_map variables_in_hypothesis in
                let status =
                  if has_supplied_schedule_instance relation outputs mode constrained
                  then ScoringView.Supplied else ScoringView.Pending in
                if status = ScoringView.Pending && not include_pending then None
                else collect
                  (if List.exists (fun (key, _) -> key = request) acc
                   then acc else (request, status) :: acc) rest) in
       collect [] steps in
     let eligible = List.filter_map (fun (id, ((steps, sort) as schedule), _, _) ->
       let local_types = List.fold_left (fun locals (step, _) ->
         let outputs = match step with
           | S_UC (name, SrcNonrec typ, _) -> [name, typ]
           | S_ST (outputs, _, _) -> outputs
           | _ -> [] in
         List.fold_left (fun locals (name, typ) ->
           if List.mem_assoc name locals then locals else locals @ [name, typ])
           locals outputs) result_vars steps in
       let known_locals = List.map fst local_types in
       let complete_telescope =
         List.for_all (fun (_, typ) -> typ <> DHole) local_types &&
         List.for_all (fun (step, _) ->
           List.for_all (fun name -> List.mem name known_locals)
             (ScoringView.step_variables step)) steps in
       match sort, complete_telescope, collect_dependencies steps with
       | ProducerSchedule (constrained, _, result), true, Some dependencies ->
         Some (id, schedule, constrained, result, local_types, dependencies)
       | _ -> None) schedule_densities in
     let env = Global.env () in
     let sigma = ref (Evd.from_env env) in
     let scores = List.map (fun (id, ((steps, _) as schedule), constrained,
         result, local_types, dependencies) ->
       let names = List.map fst result_vars @
         List.concat_map (fun (step, _) -> ScoringView.step_variables step) steps @
         ScoringView.free_vars_term result |> List.sort_uniq Stdlib.compare in
       let scope = ScoringView.scope names in
       let context = match ScoringView.dependency_context_expression
         ~global:ScoringView.global_name scope ind_name result_vars local_types
         output_vars ds constrained dependencies with
         | Ok context -> context
         | Error message -> failwith message in
       let expression = ScoringView.score_one_schedule_expression scorer
         context (policy_schedule_expression schedule) in
       match ScoringView.evaluate_term_in env !sigma expression with
       | Error message -> failwith message
       | Ok (next_sigma, value, _) ->
         sigma := next_sigma;
         id, value) eligible in
     (match scores with
      | [] -> ()
      | (_, value) :: _ ->
        Feedback.msg_notice (str ("[" ^ record_label ^ "] constructor=" ^
          constructor_to_string ctr_name ^ " score=" ^
          Pp.string_of_ppcmds (Printer.pr_econstr_env env !sigma value)));
     if List.length eligible = List.length schedule_densities &&
        List.length scores > 1 then begin
       let orders = ref [] in
       let best = List.fold_left (fun best (id, value) -> match best with
         | None -> Some (id, value)
         | Some (_, best_value) as current ->
           (match ScoringView.compare_record_scores env !sigma scorer
             value best_value with
            | Error message -> failwith message
            | Ok (next_sigma, order) ->
              sigma := next_sigma;
              orders := order :: !orders;
              if order < 0 then Some (id, value) else current)) None scores in
       match best with
       | None -> assert false
       | Some (id, _) ->
         let count order = List.length (List.filter ((=) order) !orders) in
         Feedback.msg_notice (str (Printf.sprintf
           "[%s-compare] candidates=%d best=%d lt=%d eq=%d gt=%d"
           record_label (List.length scores) id
           (count (-1)) (count 0) (count 1)))
     end));
  if score_pruning_mode <> `Off && schedule_trace_enabled () then
    Feedback.msg_notice (str (Printf.sprintf
      "[schedule-pruning-work] constructor=%s bound-cache-hits=%d bound-cache-misses=%d leaf-cache-hits=%d mode-cache-hits=%d stable-cache-entries=%d step-multisets=%d bound-cpu=%.3f leaf-cpu=%.3f final-cpu=%.3f\n"
      (constructor_to_string ctr_name) !bound_cache_hits !bound_cache_misses
      !leaf_cache_hits !mode_cache_hits
      (InductiveScheduleKeyMap.cardinal !stable_dependencies)
      distinct_step_multisets !bound_cpu !leaf_cpu !final_cpu));
  if score_pruning_mode = `Verify then begin
    let observed = List.sort_uniq Stdlib.compare !observed_leaf_scores in
    let rescored = List.map (fun (_, scored, _, _) ->
      scored_schedule_features ds 0 scored) schedule_densities
      |> List.sort_uniq Stdlib.compare in
    if observed <> rescored then
      failwith "schedule score leaf probe differs from final candidate scoring"
  end;
  constructor_inputs, schedule_densities, !prepared_inputs)

and select_best_schedule (schedules : (int * schedule_with_density) list) (ds : derive_sort) : (int * schedule * rule_density) option =
  match sort_schedules_by_density_and_var_uses schedules ds with
  | [] -> None
  | ((schd_steps_density,schd_sort), density, num_var_uses, id) :: _ -> Some (id, (List.map fst schd_steps_density,schd_sort), density)

(* With BudgetAware ranking, the chosen candidate's completed score is also
   returned, so the relation's score can aggregate it over coverage leaves. *)
and constructor_best_valid_schedule (ind_name : ty_ctr) (ctr : rocq_ctr) (result_vars : (var * rocq_constr) list) (output_vars : var list) (ds : derive_sort) (opt : bool) : ty_ctr * ((int * schedule * rule_density) * (var * mexp) list) option * BudgetAwareScore.score option =
  let constructor_inputs, scored, prepared_inputs = constructor_valid_schedules ind_name ctr result_vars output_vars ds opt in
  let entry id = List.find (fun (i, _, _, _) -> i = id) scored in
  let selected, budget = if cardinality_ranking () then begin
      let context = cardinality_context (cardinality_recursive_count result_vars output_vars) in
      (* A free generation of a type without a generator or enumerator
         instance cannot be compiled. *)
      let available (steps, _) = List.for_all (fun (step, _) -> match step with
        | S_UC (_, SrcNonrec ty, ps) ->
          has_schedule_instance ty [] (producer_sort_to_derive_sort ps) false
        | _ -> true) steps in
      let scored = List.filter (fun (_, schedule, _, _) -> available schedule) scored in
      let ranked = List.map (fun (i, (steps, _), _, _) ->
        let score = CardinalityScore.score_schedule context (List.map fst steps) in
        if Sys.getenv_opt "QC_SCHEDULE_TRACE_CONSTRUCTOR" = Some (constructor_to_string (fst ctr)) then
          Feedback.msg_notice (str (Printf.sprintf "[cardinality-candidate] id=%d %s\n" i
            (CardinalityScore.to_string score)) ++
            str (schedule_with_densities_to_string (List.assoc i
              (List.map (fun (j, sch, _, _) -> j, sch) scored))));
        i, score) scored in
      match List.fold_left (fun best (i, score) -> match best with
          | Some (_, best_score) when CardinalityScore.compare best_score score <= 0 -> best
          | _ -> Some (i, score)) None ranked with
      | None -> None, None
      | Some (id, score) ->
        let (_, ((steps, sort) as schedule), _, _) = entry id in
        if schedule_trace_enabled () then
          Feedback.msg_notice (str (Printf.sprintf
            "[schedule-ranking] policy=cardinality derive=%s candidates=%d selected-id=%d %s\n"
            (schedule_rank_derive_sort_to_string ds) (List.length ranked) id
            (CardinalityScore.to_string score))
            ++ str (schedule_with_densities_to_string schedule));
        Some (id, (List.map fst steps, sort), representative_density ds schedule), None
    end else if not (budget_aware_ranking ()) then
      select_best_schedule (List.map (fun (i, schedule, _, _) -> i, schedule) scored) ds, None
    else begin
      let context = budget_context prepared_inputs in
      let key = budget_key ind_name result_vars output_vars ds in
      let saved = !density_inductive_memo, !density_memo in
      let ranked = Fun.protect ~finally:(fun () ->
          density_inductive_memo := fst saved; density_memo := snd saved)
        (fun () -> List.map (fun (i, (steps, _), inductive_memo, density_memo_after) ->
          density_inductive_memo := inductive_memo;
          density_memo := density_memo_after;
          match BudgetAwareScore.score_schedule context key (List.map fst steps) with
          | Ok score ->
            (* QC_SCHEDULE_TRACE_CONSTRUCTOR=<name> prints every candidate's score. *)
            if Sys.getenv_opt "QC_SCHEDULE_TRACE_CONSTRUCTOR" =
               Some (constructor_to_string (fst ctr)) then
              Feedback.msg_notice (str (Printf.sprintf "[budget-candidate] id=%d %s\n" i
                (BudgetAwareScore.to_string score)) ++
                str (schedule_with_densities_to_string (List.assoc i
                  (List.map (fun (j, sch, _, _) -> j, sch) scored))));
            i, score
          | Error message -> CErrors.user_err (str (Printf.sprintf
              "BudgetAware ranking cannot score constructor %s: %s"
              (constructor_to_string (fst ctr)) message))) scored) in
      match List.fold_left (fun best (i, score) -> match best with
          | Some (_, best_score) when BudgetAwareScore.compare best_score score <= 0 -> best
          | _ -> Some (i, score)) None ranked with
      | None -> None, None
      | Some (id, score) ->
        let (_, ((steps, sort) as schedule), _, _) = entry id in
        if schedule_trace_enabled () then
          Feedback.msg_notice (str (Printf.sprintf
            "[schedule-ranking] policy=budget_aware derive=%s candidates=%d selected-id=%d %s\n"
            (schedule_rank_derive_sort_to_string ds) (List.length ranked) id
            (BudgetAwareScore.to_string score))
            ++ str (schedule_with_densities_to_string schedule));
        Some (id, (List.map fst steps, sort), representative_density ds schedule), Some score
    end in
  (match selected with
   | None -> ()
   | Some (id, _, _) ->
     let (_, schedule, inductive_memo, density_memo_after) = entry id in
     log_schedule_selection ind_name ctr result_vars output_vars ds opt schedule;
     density_inductive_memo := inductive_memo;
     density_memo := density_memo_after);
  fst ctr, Option.map (fun chosen -> chosen, constructor_inputs) selected, budget

and inductive_best_valid_schedule (rel : rocq_relation) (output_idxs : int list) (ds : derive_sort) (opt : bool) : inductive_schedule * rule_density =
  let (ind_name, params, ctrs, result_typ) = rel in
  let memo_key = (ind_name, output_idxs, ds, opt) in
  match InductiveScheduleKeyMap.find_opt memo_key !density_inductive_memo with
  | Some entry -> record_density_read memo_key (Some entry); read_inductive_density memo_key entry
  | None ->
  record_density_read memo_key None;
  let reusable = if Sys.getenv_opt "QC_SCHEDULE_CONTEXT_REUSE" = Some "0" then None
    else List.find_opt context_holds
      (Stdlib.Option.value ~default:[] (Hashtbl.find_opt contextual_derivations memo_key)) in
  match reusable with
  | Some record -> replay_contextual_derivation memo_key record
  | None -> begin
  let frame = Hashtbl.create 16 in
  let memo_at_start = !density_inductive_memo in
  derivation_frames := frame :: !derivation_frames;
  let depth, saved_low = enter_density_derivation memo_key in
  Fun.protect ~finally:(fun () ->
    derivation_frames := List.tl !derivation_frames;
    leave_density_derivation memo_key depth saved_low) (fun () ->
  Error.msg_debug (str "Inductive name: " 
  ++ str (ty_ctr_to_string ind_name)
  ++ str "\n Parameters: "
  ++ str (String.concat ", " (List.map ty_param_to_string params)) 
  ++ str "\n Result Type: "
  ++ str (rocq_constr_to_string result_typ) 
  ++ str "\n Output indices: "
  ++ str (String.concat ", " (List.map string_of_int output_idxs)) 
  ++ str "\n\n");

  (* Result binders must be distinct from constructor binders. Substitute each
     renaming into subsequent types, including dependent indices. *)
  let rec rename names = function
    | DTyVar v -> DTyVar (try List.assoc v names with Not_found -> v)
    | DTyCtr (c, args) -> DTyCtr (c, List.map (rename names) args)
    | DCtr (c, args) -> DCtr (c, List.map (rename names) args)
    | DApp (f, args) -> DApp (rename names f, List.map (rename names) args)
    | DNot p -> DNot (rename names p)
    | DArrow (a,b) -> DArrow (rename names a, rename names b)
    | DProd ((v,t), b) -> DProd ((v, rename names t), rename (List.remove_assoc v names) b)
    | DLambda (v,t,b) -> DLambda (v, rename names t, rename (List.remove_assoc v names) b)
    | DMatch (t, branches) -> DMatch (rename names t, List.map (fun (pat, body) ->
        pat, rename (List.filter (fun (v,_) -> not (List.mem v (NewGenericLib.pat_vars pat))) names) body) branches)
    | (DTyParam _ | DHole) as t -> t in
  let rec get_result_vars names = function
  | DProd ((v,t), b) ->
    let fresh = make_up_name_str ("v_" ^ var_to_string v) in
    (fresh, rename names t) :: get_result_vars ((v, fresh) :: names) b
  | DArrow (t1, t2) ->
    let v = make_up_name_str "v" in
    (v, rename names t1) :: get_result_vars names t2
  | _ -> [] in

  let dtype = (DTyCtr (ty_ctr_of_string "Type", [])) in

  let result_vars = List.map (fun p -> (p, dtype)) params @ get_result_vars [] result_typ in

  let rec remake_result vars result = 
  match vars, result with
  | [], _ -> result
  | (v,t) :: rest, DProd  (_, t') 
  | (v,t) :: rest, DArrow (_, t') -> DProd ((v,t), remake_result rest t')
  | _ -> failwith "remake_result failed" in

  with_schedule_inputs (List.map (fun (v,t) -> v, product_free_rocq_type_to_mexp t) result_vars) (fun () ->
  let output_vars = List.map fst (List.filteri (fun i _ -> List.mem i output_idxs) result_vars) in

  let modestring = String.init (List.length result_vars) (fun i -> if List.mem i output_idxs then 'O' else 'I') in

  let typeclass_name = function
    | (D_Check, _) -> "DecOpt"
    | (D_Thm, _) -> failwith "Inductives cannot make theorems"
    | (D_Gen, false) -> "GenSized" 
    | (D_Gen, true) -> "GenSizedSuchThat" 
    | (D_Enum, false) -> "EnumSized"
    | (D_Enum, true) -> "EnumSizedSuchThat" in

  let schedule_name = Printf.sprintf "%s_%s_%s" (typeclass_name (ds, opt)) (ty_ctr_to_string ind_name) modestring in

  let init_density = match ds with
    | D_Check | D_Enum -> Checking
    | D_Gen | D_Thm -> if opt then Partial else Total in

  Error.msg_debug (str "Params are: " ++ str (String.concat ", " (List.map ty_param_to_string params)) ++ fnl ());

  let parameters_classes = [] in

  Error.msg_debug (str "Parameters classes are: " ++ str (String.concat ", " (List.map (fun (p,cs) -> ty_param_to_string p ^ ": " ^ String.concat ", " (List.map mexp_to_string cs)) parameters_classes)) ++ fnl ());

  density_inductive_memo := InductiveScheduleKeyMap.add (ind_name, output_idxs, ds, opt) (DensityInProgress ((schedule_name,[],parameters_classes,[],[]), init_density)) !density_inductive_memo;

  let constructor_schedules_with_density = List.filter_map (fun ctr ->
    match constructor_best_valid_schedule ind_name ctr result_vars output_vars ds opt with
    | (ctr_name, None, _) -> raise (Unavailable_mode (constructor_to_string ctr_name))
    | (ctr_name, Some ((i, schd, density), binders), budget) ->
      Some ((schd, [], binders), (ctr_name, density), (ctr_name, budget))) ctrs in

  let constructor_schedules = List.map (fun (s, _, _) -> s) constructor_schedules_with_density in
  let densities = List.map (fun (_, d, _) -> d) constructor_schedules_with_density in
  let budget_scores = List.map (fun (_, _, b) -> b) constructor_schedules_with_density in

  let is_recursive ((steps,_),_,_) =
    List.exists (function | S_UC (_,SrcRec _,_) | S_ST (_,SrcRec _, _) | S_Check (SrcRec _,_) -> true | _ -> false) steps 
  in

  (* let param_typeclass_required (src : source) : (var * mexp) option =
     *)

  let (nonrecursive, recursive) = List.partition is_recursive constructor_schedules in

  let result_vars_mexps = filter_mapi (fun i (v,t) -> if List.mem i output_idxs then None else Some (v, NewGenericLib.product_free_rocq_type_to_mexp t)) result_vars in 

  Error.msg_debug (str "Result variables and their mexps: " ++ str (String.concat ", " (List.map (fun (v,mexp) -> var_to_string v ^ ": " ^ mexp_to_string mexp) result_vars_mexps)) ++ fnl ());

  let inductive_schedule : inductive_schedule =
    (schedule_name, result_vars_mexps, parameters_classes, recursive, nonrecursive)
  in

  let fold_left1 f acc l =
    match l with
    | [] -> acc
    | x :: xs -> List.fold_left f x xs in

  let sparsest densities =
    fold_left1 (fun acc d -> if d > acc then d else acc) Checking densities in

  let densest densities =
    fold_left1 (fun acc d -> if d < acc then d else acc) Total densities in

  let best_density densities = 
    match ds with
    | D_Check | D_Enum -> densest densities
    | D_Gen | D_Thm -> sparsest densities in

  let worst_density densities = 
    match ds with
    | D_Check | D_Enum -> sparsest densities
    | D_Gen | D_Thm -> densest densities in

  let inductive = (match get_inductive_name ind_name with | Some i -> i | None -> failwith "final_density: not an inductive type") in
  let tree = cover_tuple_patterns (input_patterns_of_rocq_relation rel output_idxs) (rocq_relation_arity rel) (types_to_constructor_lookup (seek_rocq_relations inductive)) in
  let covered_patterns = collect_leaves tree in
  (* if should_print then (Feedback.msg_notice (str ("Rule densities for: " ^ ty_ctr_to_string ind_name ^ " with output indices: " ^ List.fold_left (fun acc oi -> acc ^ " " ^ string_of_int oi) "" ois) ++ fnl ()); *)
  (* print_rule_densities densities); *)
  (* let filter_empty_constructors = List.map (fun (p, cs) -> p, List.filter (fun c -> match List.assoc c densities with | Checking -> false | Partial | Backtracking -> true) cs) covered_patterns in
  let any_uncovered = List.exists (fun (p,cs) -> cs = []) filter_empty_constructors in
  let all_has_partial = List.for_all (fun (p,cs) -> List.exists (fun c -> List.assoc c densities = Partial) cs) filter_empty_constructors in
  let result = if any_uncovered then Checking else if all_has_partial then Partial else Backtracking in *)
  let filter_uncovered_patterns = List.filter (fun (p, cs) -> match cs with | [] -> false | _ -> true) covered_patterns in
  let best_density_in_patterns = List.map (fun (p, cs) -> best_density (List.map (fun c -> List.assoc c densities) cs)) filter_uncovered_patterns in
  let overall_density = worst_density ((if List.exists (function (_,[]) -> true | _ -> false) covered_patterns && (match ds with D_Gen | D_Thm -> true | _ -> false) then [Partial] else []) @ best_density_in_patterns) in

  (Error.msg_debug (str "Rule pattern coverage tree:" ++ fnl ());
                        print_coverage_tree ind_name tree output_idxs; Error.msg_debug (fnl ());
                        Error.msg_debug (str "Set of patterns and densities of their covering rules:" ++ fnl ());
                        print_pattern_leaves ind_name tree output_idxs densities; 
                        Error.msg_debug (str ("Inductive relation " ^ ty_ctr_to_string ind_name ^ " with output indices:"
                                                  ^ List.fold_left (fun acc oi -> acc ^ " " ^ string_of_int oi) "" output_idxs 
                                                  ^ " has overall density: " 
                                                  ^ (density_to_string overall_density)) ++ fnl ()));

  let cycle_independent = !density_low_read >= depth in
  if not cycle_independent then
    cycle_low := InductiveScheduleKeyMap.add memo_key !density_low_read !cycle_low;
  (* Specimen's inductive score: combine, over coverage leaves, the best
     score among the leaf's constructors; an uncovered leaf scores Partial. *)
  if cardinality_ranking () then begin
    let context = cardinality_context None in
    let steps = List.map (fun ((steps, _), _, _) -> steps) constructor_schedules in
    let count = CardinalityScore.mode_count_of context ds steps in
    match cardinality_count_key ind_name output_idxs ds with
    | Some key ->
      if Sys.getenv_opt "QC_CARDINALITY_TRACE" <> None then
        Feedback.msg_notice (str (Printf.sprintf "[cardinality-count] %s|%s|%s %s\n"
          (ty_ctr_to_string ind_name) (String.concat "," (List.map string_of_int output_idxs))
          (schedule_rank_derive_sort_to_string ds) (CardinalityScore.cls_to_string count)));
      Hashtbl.replace cardinality_counts key count;
      if List.length ctrs = List.length steps then
        Hashtbl.replace cardinality_shapes key (List.map2 (fun (_, ty) steps ->
          conclusion_arguments ty, snd (CardinalityScore.constructor_count context steps)) ctrs steps)
    | None -> ()
  end;
  let budget_score = if not (budget_aware_ranking ()) then None else
    let score_of c = match List.assoc_opt c budget_scores with
      | Some (Some score) -> Some score | _ -> None in
    Some (BudgetAwareScore.inductive_score
      (List.map (fun (_, cs) -> List.filter_map score_of cs) covered_patterns)) in
  density_inductive_memo := InductiveScheduleKeyMap.add (ind_name, output_idxs, ds, opt) (DensityDone ((inductive_schedule, overall_density), cycle_independent, budget_score)) !density_inductive_memo;
  Error.msg_debug (str (Printf.sprintf "%s: %s Done, Density: %s, cycle-independent: %b\n" (schedule_name) (String.concat ", " (List.map string_of_int output_idxs)) (density_to_string overall_density) cycle_independent));
  if cycle_independent then
    Hashtbl.replace stable_closures memo_key
      (List.filter (fun (k, _) -> k <> memo_key) (memo_delta memo_at_start))
  else
    remember_contextual_derivation memo_key frame memo_at_start
      (inductive_schedule, overall_density);
  inductive_schedule, overall_density))
end

and best_inductive_schedule_from_instance (ind_instance : rocq_type) (output_vars : var list) (ds : derive_sort) (opt : bool) : inductive_schedule * rule_density =
  if has_schedule_instance ind_instance output_vars ds opt then
    (("resolved_instance", [], [], [], []),
     if ds = D_Check || ds = D_Enum then Checking else if opt then Partial else Total)
  else
  (* Only arguments headed by an inductive type are types to instantiate. A
     defined function applied to values, such as [f a x] in [R (f a x) y], is
     a value argument and has no generator of its own. *)
  let rec instantiate_applied_types (ty : rocq_type) : unit =
    match ty with
    | DTyCtr (ind_name, args) ->
      List.iter (function
      | DTyCtr (applied_ind_name, applied_args) when is_inductive' applied_ind_name ->
        ignore (best_inductive_schedule_from_instance (DTyCtr (applied_ind_name, applied_args)) [] (match ds with | D_Gen | D_Thm -> D_Gen | D_Check | D_Enum -> D_Enum) false);
        List.iter instantiate_applied_types applied_args
      | _ -> ()) args
    | _ -> () in

  match ind_instance with
  | DTyCtr (ind_name, args) -> 
    let output_idxs = filter_mapi (fun i -> function | DTyVar v -> if List.mem v output_vars then Some i else None | _ -> None) args in
    (* Feedback.msg_debug (str (ty_ctr_to_string ind_name ^ " with output indices: " ^ String.concat "," (List.map string_of_int output_idxs)) ++ fnl ()); *)
    instantiate_applied_types ind_instance;
    inductive_best_valid_schedule (ty_ctr_to_rocq_relation ind_name) output_idxs ds opt
  | DNot (DTyCtr (ind_name, args)) when ds = D_Check ->
    instantiate_applied_types (DTyCtr (ind_name, args));
    inductive_best_valid_schedule (ty_ctr_to_rocq_relation ind_name) [] ds opt
  | _ -> failwith "best_inductive_schedule_from_instance: not a DTyCtr"

let grouped_selector ds = match schedule_group_mode () with
  | `Off -> None
  | `On | `Verify -> Some (schedule_group_selector ds)

(* Ranked theorem schedules. With grouped search, indices and the try-all
   tactic range over the grouped combinations, not every joint ordering. *)
(* Lazy scoring for selecting the best theorem schedule. Candidates are
   visited in identifier order. A candidate's density is the minimum grade of
   its steps and its variable uses are structural, so once the grades seen so
   far bound it no better than the incumbent, which precedes it and wins ties,
   it cannot be selected and its remaining dependency modes are not derived. *)
let theorem_candidate_loses ~incumbent ms_steps ((steps, sort) : schedule) =
  let policy = schedule_ranking_policy () in
  let all_steps = ms_steps @ steps in
  let variable_uses = get_num_var_uses
    (List.map (fun step -> step, Total) all_steps, sort) D_Thm in
  let fixed, derived = List.partition (fun step ->
    fixed_step_density D_Thm step <> None) all_steps in
  let rec visit known = function
    | [] -> false
    | step :: rest ->
      let grade = match fixed_step_density D_Thm step with
        | Some grade -> Some (density_rank grade)
        | None ->
          let before = !density_uncertainty_events in
          (match schedule_density [] ([step], sort) with
           | ([(_, grade)], _) when !density_uncertainty_events = before ->
             Some (density_rank grade)
           | _ -> None) in
      let known = grade :: known in
      ScheduleRanking.can_prune_after ~prefer_dense:true policy ~incumbent
        ~bound:(ScheduleRanking.prefix_bound ~prefer_dense:true
          ~known_grades:known ~variable_uses)
      || visit known rest in
  visit [] (fixed @ derived)

let theorem_lazy_scoring () =
  Sys.getenv_opt "QC_THEOREM_LAZY_SCORING" <> Some "0"

let all_theorem_schedules ?(best_only = false) (thm : rocq_type) =
  let rank ~lazy_best schedule_matches =
    let schedules = List.mapi (fun i ((steps, sort), ms, eqs) -> i,List.map (fun (v,p) -> S_Match (v,p)) ms, ((List.map check_eq eqs @ steps), sort)) schedule_matches in
    let initial_inductive_memo = !density_inductive_memo in
    let initial_density_memo = !density_memo in
    let incumbent = ref None in
    let scored = Fun.protect
      ~finally:(fun () ->
        density_inductive_memo := initial_inductive_memo;
        density_memo := initial_density_memo)
      (fun () -> List.filter_map (fun (i, ms_steps, schd) ->
        density_inductive_memo := with_stable_entries initial_inductive_memo;
        density_memo := initial_density_memo;
        if lazy_best && (match !incumbent with
            | Some best -> theorem_candidate_loses ~incumbent:best ms_steps schd
            | None -> false)
        then begin
          collect_stable_entries initial_inductive_memo;
          if schedule_trace_enabled () then
            Feedback.msg_notice (str (Printf.sprintf "[theorem-lazy] candidate=%d skipped\n" i));
          None
        end else
        let result = schedule_density ms_steps schd in
        if lazy_best then begin
          let features = scored_schedule_features D_Thm i result in
          if schedule_trace_enabled () then
            Feedback.msg_notice (str (Printf.sprintf
              "[theorem-lazy] candidate=%d scored density=%d uses=%d\n" i
              features.ScheduleRanking.density_rank features.ScheduleRanking.variable_uses)
              ++ str (schedule_to_string schd));
          match !incumbent with
          | Some best when ScheduleRanking.compare ~prefer_dense:true
              (schedule_ranking_policy ()) features best >= 0 -> ()
          | _ -> incumbent := Some features
        end;
        collect_stable_entries initial_inductive_memo;
        let inductive_memo = !density_inductive_memo in
        let density_memo_after = !density_memo in
        if are_schedule_steps_valid i result then
          Some (i, result, inductive_memo, density_memo_after)
        else None) schedules) in
    let ranked = sort_schedules_by_density_and_var_uses
      (List.map (fun (i, result, _, _) -> i, result) scored) D_Thm in
    List.map (fun ((schd_steps_density, schd_sort) as scored_schedule, density, num_var_uses, id) ->
      let (_, _, inductive_memo, density_memo_after) =
        List.find (fun (i, _, _, _) -> i = id) scored in
      scored_schedule,
      ((List.map fst schd_steps_density, schd_sort), density, num_var_uses,
       inductive_memo, density_memo_after)) ranked in
  let matches select_groups =
    NewUnifyQC.type_to_schedules ?select_groups thm None None [] [] D_Thm true in
  let lazy_best = best_only && theorem_lazy_scoring () in
  let rank_exhaustive = rank ~lazy_best:false in
  let rank = rank ~lazy_best in
  let ranked = rank (matches (grouped_selector D_Thm)) in
  if lazy_best && Sys.getenv_opt "QC_SCHEDULE_SCORE_PRUNING" = Some "verify" then begin
    let best entries = match entries with
      | (scored, _) :: _ -> Some (scored_schedule_features D_Thm 0 scored)
      | [] -> None in
    let exhaustive = rank_exhaustive (matches (grouped_selector D_Thm)) in
    if best exhaustive <> best ranked then
      failwith "lazy theorem scoring changed the selected schedule"
  end;
  if schedule_group_mode () = `Verify then begin
    let best entries = match entries with
      | (scored, _) :: _ -> Some { (scored_schedule_features D_Thm 0 scored)
                                   with ScheduleRanking.candidate_id = 0 }
      | [] -> None in
    let joint = rank (matches None) in
    if best joint <> best ranked then
      failwith "grouped theorem schedule search changed the best score"
  end;
  List.map snd ranked

let best_theorem_schedule (thm : rocq_type) : schedule =
  match all_theorem_schedules ~best_only:true thm with
  | (schedule, _, _, _, _) :: _ -> schedule
  | [] -> failwith "best_theorem_schedule: No valid schedules found"

let collect_inductive_dependents (instance : rocq_constr * int list * derive_sort * bool) : (rocq_constr * int list * derive_sort * bool) list =
  let (ind_instance, output_idxs, ds, opt) = instance in
  match ind_instance with
  | DTyCtr (ind_name,_) -> 
    let (inductive_schd, density) = inductive_density_value (InductiveScheduleKeyMap.find (ind_name, output_idxs, ds, opt) !density_inductive_memo) in
    inductive_schedule_dependents inductive_schd
  | DTyParam param -> []
    (* failwith "collect_inductive_dependents: Need to handle instances of parameter type variables, like A in list A" *)
  | _ -> failwith "collect_inductive_dependents: not a DTyCtr or DTyVar"

let resolved_dependency (relation, output_indices, ds, constrained) =
  let args = match relation with
    | DTyCtr (_, args) | DNot (DTyCtr (_, args)) -> args
    | _ -> [] in
  let outputs = List.concat (filter_mapi (fun i arg ->
    if List.mem i output_indices then Some (variables_in_hypothesis arg) else None) args) in
  (* Code generation decides here whether a dependency is compiled; recheck
     against the current context rather than a cached answer. *)
  has_schedule_instance ~cached:false relation outputs ds constrained

let lookup_and_remove_inductive_schedule (instance : rocq_constr * int list * derive_sort * bool) (to_remove : bool) : (inductive_schedule * derive_sort * bool) option =
  let (ind_instance, output_idxs, ds, opt) = instance in
  match ind_instance with
  | DTyCtr (ind_name,_)  | DNot (DTyCtr (ind_name, _)) ->
    (try (let (inductive_schd, density) = inductive_density_value (InductiveScheduleKeyMap.find (ind_name, output_idxs, ds, opt) !density_inductive_memo) in
    if to_remove then density_inductive_memo := InductiveScheduleKeyMap.remove (ind_name, output_idxs, ds, opt) !density_inductive_memo;
    Some (inductive_schd, ds, opt)) with Not_found -> None)
  | DTyVar v -> failwith "lookup_and_remove_inductive_schedule: Need to handle instances of parameter type variables, like A in list A"
  | _ -> failwith ("lookup_and_remove_inductive_schedule: not a DTyCtr or DTyVar: " ^ rocq_constr_to_string ind_instance)

let update_source step src =
  match step with
  | S_UC (v,_,ps) -> S_UC (v, src, ps)
  | S_Check (_,pol) -> S_Check (src, pol)
  | S_ST (vs,_,ps) -> S_ST (vs, src, ps)
  | S_Match (v,pat) -> S_Match (v, pat)
  | S_Let (v,c) -> S_Let (v,c)

let nonrec_to_mutrec_call name ois ty opt param_typeclasses : source =
  match ty with
  | DTyCtr (ind, args) -> 
    let input_args = filter_mapi (fun i arg -> if List.mem i ois then None else Some arg) args in
    let typeclass_count = List.length (List.concat_map snd param_typeclasses) in
    SrcDef (var_of_string name, input_args @ List.init typeclass_count (fun _ -> DHole))
  | _ -> failwith "nonrec_to_mutrec_call: not a DTyCtr"

let rec_call_add_typeclass_holes name args typeclass_count : source =
  SrcRec (name, args @ List.init typeclass_count (fun _ -> DHole))

let rec_calls_add_typeclass_holes (schedule,matches) param_typeclasses : (schedule * (var * pat) list) =
  let typeclass_count = List.length (List.concat_map snd param_typeclasses) in

  let aux step =
    match step with
    | S_UC (v, SrcRec (f, args), ps) ->
      S_UC (v, rec_call_add_typeclass_holes f args typeclass_count, ps)
    | S_ST (vs, SrcRec (f, args), ps) ->
      S_ST (vs, rec_call_add_typeclass_holes f args typeclass_count, ps)
    | S_Check (SrcRec (f, args), pol) ->
      S_Check (rec_call_add_typeclass_holes f args typeclass_count, pol)
    | _ -> 
      step in
  let (steps, sort) = schedule in
  (List.map aux steps, sort), matches

let nonrecursive_type step =
  match step with
  | S_UC (_,SrcNonrec ty,_)
  | S_ST (_,SrcNonrec ty,_) 
  | S_Check (SrcNonrec ty,_) -> ty
  | S_Match _ -> failwith "nonrecursive_type: step must not be a match"
  | S_Let _ -> failwith "nonrecursive_type: step must not be a let"
  | _ -> failwith "nonrecursive_type: step must have nonrecursive source"

let insert_mutrec_call name ois step opt param_typeclasses =
  update_source step (nonrec_to_mutrec_call name ois (nonrecursive_type step) opt param_typeclasses)

let insert_mutrec_calls ?within ((schedule,matches) : schedule * (var * pat) list) : schedule * (var * pat) list =
  let (schedule_steps_deps,schd_sort_dep) = schedule_with_dependents schedule in
  let zero = DCtr (constructor_of_string "Coq.Init.Datatypes.O", []) in
  let succ n = DCtr (constructor_of_string "Coq.Init.Datatypes.S", [n]) in 
  let three = succ (succ (succ zero)) in
  let mul n m = DCtr (constructor_of_string "Coq.Init.Nat.mul", [n; m]) in (*TODO: Add Constants to the language so I don't have to apply functions as if they are constructors.*)
  let updated_steps = List.map (fun (step,depopt) -> 
                                    (match (depopt >>= fun dep -> if resolved_dependency dep then None else
                                      (match lookup_and_remove_inductive_schedule dep false with
                                       | Some ((name,_,_,_,_),_,_) as found ->
                                           (match within with Some names when not (List.mem name names) -> None | _ -> found)
                                       | None -> None)) with
                                    | None -> step
                                    | Some ((ind_schd_name,_,param_typeclasses,_,_),ds,opt) -> (*TODO: use the info from this inductive schedule to determine whether any 
                                                                               arguments of Dec_Eq or Show or Gen are needed*)
                                                                             (* Likely adding this explicitly to the definition of an inductive schedule
                                                                                for ease of access.*)
                                      let Some (_,ois,_,_) = depopt in insert_mutrec_call ind_schd_name ois step opt param_typeclasses)) 
                        schedule_steps_deps in 
          
  let updated_sort = match schd_sort_dep with
    | (TheoremSchedule (t,true), Some (ctr, ois, ds, opt)) ->
      Error.msg_debug (str ("Inserting mutrec calls for theorem: " ^ rocq_constr_to_string ctr) ++ fnl ()); 
      (match (if resolved_dependency (ctr, ois, ds, opt) then None else
        (match lookup_and_remove_inductive_schedule (ctr, ois, ds, opt) false with
         | Some ((name,_,_,_,_),_,_) as found ->
             (match within with Some names when not (List.mem name names) -> None | _ -> found)
         | None -> None)) with
      | None -> TheoremSchedule (t,true)
      | Some ((schd_name,_,param_typeclasses,_,_), _, _) ->
        let typeclass_holes = List.init (List.length (List.concat_map snd param_typeclasses)) (fun _ -> DHole) in
      (match t with
      | DTyCtr (_, args) -> 
        let input_args = filter_mapi (fun i arg -> if List.mem i ois then None else Some arg) args in
        let fuel_arg = mul three (DTyVar (var_of_string "size")) in
        let new_conclusion = DApp (DTyVar (var_of_string schd_name), fuel_arg :: input_args @ typeclass_holes) in
        TheoremSchedule (new_conclusion, false)
      | DNot (DTyCtr (_, args)) ->
        let input_args = filter_mapi (fun i arg -> if List.mem i ois then None else Some arg) args in
        let fuel_arg = mul three (DTyVar (var_of_string "size")) in
        let new_conclusion = DNot (DApp (DTyVar (var_of_string schd_name), fuel_arg :: input_args @ typeclass_holes)) in
        TheoremSchedule (new_conclusion, false)
      | _ -> failwith "insert_mutrec_calls: TheoremSchedule must have DTyCtr at toplevel"))
    | (schd_sort,_) -> schd_sort in

  (updated_steps, updated_sort), matches

let insert_mutrec_calls_inductive_schedule ?within (is : inductive_schedule) : inductive_schedule =
  let (name, result_vars, param_deps, nonrecursive_hyps, recursive_hyps) = is in
  Error.msg_debug (str ("Inserting mutrec calls for inductive schedule: " ^ name) ++ fnl ());
  let update add_holes (schedule, matches, binders) =
    let local_binders = List.filter (fun (v, _) -> not (List.mem_assoc v result_vars)) binders in
    with_schedule_inputs (result_vars @ local_binders) (fun () ->
      let updated = insert_mutrec_calls ?within (schedule, matches) in
      let schedule, matches = if add_holes then rec_calls_add_typeclass_holes updated param_deps else updated in
      schedule, matches, binders) in
  let updated_nonrecursive_hyps = List.map (update false) nonrecursive_hyps in
  let updated_recursive_hyps = List.map (update true) recursive_hyps in
  (name, result_vars, param_deps, updated_nonrecursive_hyps, updated_recursive_hyps)

module InductiveSchedSet = Set.Make(struct type t = inductive_schedule * derive_sort * bool let compare = compare end)

module InductiveSchedMap = Map.Make(struct type t = inductive_schedule * derive_sort * bool 
  let compare ((ind_name,_,_,_,_), ds1, opt1) ((ind_name,_,_,_,_), ds2, opt2) =
    match compare ind_name ind_name with
    | 0 -> (match compare ds1 ds2 with
            | 0 -> compare opt1 opt2
            | r -> r)
    | r -> r end)

let dec_eq_sched_phony = ("DecOpt_eq_III", [], [], [(([],CheckerSchedule),[],[])], [(([],CheckerSchedule),[],[])])
   
let init_density_inductive_memo = InductiveScheduleKeyMap.add (ty_ctr_of_string "Coq.Init.Logic.eq", [], D_Check, true) (DensityDone ((dec_eq_sched_phony, Checking), true, None)) InductiveScheduleKeyMap.empty

let reset_density_inductive_memo () =
  Hashtbl.reset cardinality_counts;
  Hashtbl.reset cardinality_shapes;
  Hashtbl.reset cardinality_conditional_memo;
  Hashtbl.reset cardinality_type_cache;
  Hashtbl.reset stable_closures;
  clear_inductive_name_cache ();
  clear_schedule_instance_cache ();
  stable_density_entries := InductiveScheduleKeyMap.empty;
  Hashtbl.reset contextual_derivations;
  density_inductive_memo := init_density_inductive_memo

(* Diagnostic scoring must not consume or leave behind entries from another
   proof context. Normal derivation commands establish their own memo state. *)
let with_fresh_density_memo f =
  let old_inductive = !density_inductive_memo in
  let old_stable = !stable_density_entries in
  let old_contextual = Hashtbl.copy contextual_derivations in
  let old_closures = Hashtbl.copy stable_closures in
  let old_rule = !density_memo in
  let old_relations = !rocq_relation_memo in
  Fun.protect
    ~finally:(fun () ->
      density_inductive_memo := old_inductive;
      stable_density_entries := old_stable;
      Hashtbl.reset contextual_derivations;
      Hashtbl.iter (Hashtbl.replace contextual_derivations) old_contextual;
      Hashtbl.reset stable_closures;
      Hashtbl.iter (Hashtbl.replace stable_closures) old_closures;
      density_memo := old_rule;
      rocq_relation_memo := old_relations)
    (fun () ->
      reset_density_inductive_memo ();
      density_memo := RelationInstMap.empty;
      rocq_relation_memo := TyCtrMap.empty;
      f ())

let inductive_set_init = InductiveSchedSet.singleton (dec_eq_sched_phony, D_Check, false)

let inductive_set = ref inductive_set_init

module StringMap = Map.Make(String)

(* let inductive_dependency_map : (string list) StringMap.t ref = ref StringMap.empty *)

let concat_pair_map (f : 'a -> ('b list * 'c list)) (l : 'a list) : ('b list * 'c list) =
  List.fold_left (fun (bs,cs) a -> let (b,c) = f a in (bs @ b, cs @ c)) ([],[]) l

(* let rec collect_all_used_inductives ((ind_schd, ds, opt) : inductive_schedule * derive_sort * bool) : ((inductive_schedule * derive_sort * bool) list) * ((inductive_schedule * derive_sort * bool) list) =
  if InductiveSchedSet.mem (ind_schd, ds, opt) !inductive_set then 
    (Feedback.msg_debug (str ("Already collected inductive schedule: " ^ (match ind_schd with (name,_,_,_) -> name)) ++ fnl ());
    ([],[]))
  else begin
