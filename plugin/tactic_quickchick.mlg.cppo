let rec take_while (p : 'a -> bool) (l : 'a list) : ('a list) * ('a list) =
  match l with
  | a :: l' when p a -> 
    let (start,rest) = take_while p l' in
    (a :: start, rest)
  | _ -> ([], l)

(* Propagate complete premises, with the dependency's formal arguments replaced
   by the actual call arguments. Keep raw schedules until this fixed point is
   reached: recursive call dictionaries depend on the final signatures. *)
let propagate_schedule_requirements components =
  let open NewGenericLib in
  let all = ref (List.concat components) in
  let same_requirement inputs a b =
    (* Kernel conversion ignores bound-variable spelling. Comparing printed
       syntax can grow the fixed point forever when predicates are alpha-renamed. *)
    let close body = mexp_to_constr_expr
      (MFun (List.map (fun (v,t) -> PVar v, Some t) inputs, body)) D_Check in
    let env = schedule_env () in
    let sigma, a = Constrintern.interp_constr_evars env (schedule_sigma env) (close a) in
    let sigma, b = Constrintern.interp_constr_evars env sigma (close b) in
    try ignore (Evarconv.unify env sigma Conversion.CONV a b); true
    with Pretype_errors.PretypeError _ -> false in
  let requirements_of ((name, inputs, _, base, recursive), ds, _) =
    if ds = D_Thm then [] else
    with_schedule_inputs inputs (fun () ->
      let add acc requirement =
        if List.exists (fun r -> same_requirement inputs r requirement) acc
        then acc else acc @ [requirement] in
      let from_obligation relation outputs sort constrained =
        let env, sigma, goal, names = elaborate_obligation relation outputs sort constrained in
        match instance_requirements ~allow_root:(match relation with DTyParam _ -> true | _ -> false)
          env sigma goal names with Some requirements -> requirements | None -> [] in
      let from_dependency relation outputs sort constrained =
        let existing = from_obligation relation outputs sort constrained in
        if has_schedule_instance relation outputs sort constrained then existing else
        let relation = match relation with DNot p -> p | p -> p in
        match relation with
        | DTyCtr (ind, args) ->
          let output_indices = filter_mapi (fun i arg ->
            if List.exists (fun v -> List.mem v outputs) (obligation_variables arg) then Some i else None) args in
          let dependency_name = construct_ind_schd_name (ind, List.length args, output_indices, sort, constrained) in
          (match List.find_opt (fun ((n,_,_,_,_),_,_) -> n = dependency_name) !all with
          | None -> existing
          | Some ((_, dep_inputs, requirements, _, _), _, _) ->
            let input_args = filter_mapi (fun i arg -> if List.mem i output_indices then None
              else Some arg) args in
            let actuals = List.map product_free_rocq_type_to_mexp input_args in
            List.concat_map (fun requirement ->
              let fn = mexp_to_constr_expr (MFun (List.map (fun (v,t) -> PVar v, Some t) dep_inputs, requirement)) sort in
              let expression = MEscape (Constrexpr_ops.mkAppC
                (fn, List.map (fun arg -> mexp_to_constr_expr arg sort) actuals)) in
              let env, sigma, goal, names = elaborate_schedule_expression
                (List.concat_map obligation_variables input_args) [] sort expression in
              match instance_requirements ~allow_root:true env sigma goal names with
              | Some needed -> needed
              | None -> CErrors.user_err (str ("QuickChick cannot propagate a dependency requirement into " ^ name)))
              (List.concat_map snd requirements))
        | _ -> existing in
      let step_requirements = function
        | S_UC (_, SrcNonrec ty, ps) ->
          from_dependency ty [] (producer_sort_to_derive_sort ps) false
        | S_ST (outputs, SrcNonrec relation, ps) ->
          from_dependency relation (List.map fst outputs) (producer_sort_to_derive_sort ps) true
        | S_Check (SrcNonrec relation, _) -> from_dependency relation [] D_Check true
        | _ -> [] in
      List.fold_left add [] (List.concat_map (fun ((steps,_),_,binders) ->
        let binders = List.filter (fun (v, _) -> not (List.mem_assoc v inputs)) binders in
        with_schedule_inputs (inputs @ binders) (fun () ->
          List.concat_map step_requirements steps)) (base @ recursive))) in
  let rec fixed_point () =
    let changed = ref false in
    let updated = List.map (fun (((name, inputs, previous, base, recursive), ds, constrained) as entry) ->
      let needed = requirements_of entry in
      let old = List.concat_map snd previous in
      let needed = List.fold_left (fun acc ty ->
        if List.exists (fun t -> same_requirement inputs t ty) acc then acc else acc @ [ty]) old needed in
      if List.length needed <> List.length old then changed := true;
      let requirements = if needed = [] then [] else [var_of_string "requirement", needed] in
      (name, inputs, requirements, base, recursive), ds, constrained) !all in
    all := updated;
    if !changed then fixed_point () in
  fixed_point ();
  List.map (List.map (fun ((name,_,_,_,_),_,_) ->
    List.find (fun ((n,_,_,_,_),_,_) -> name = n) !all)) components

let tarjan_schedules_by_name (schedules : string list) inductive_dependency_map
    : (inductive_schedule * derive_sort * bool) list list =
  let index = ref 0 in
  let stack = ref [] in
  let components = ref [] in
  let dep_count = List.length schedules in
  let in_stack = Array.make dep_count false in
  let eq_sentinel_index = -1 in
  let vertex_indices = ref (StringMap.add "DecOpt_Coq.Init.Logic.eq_III" eq_sentinel_index
                            (StringMap.singleton "DecOpt_eq_III" eq_sentinel_index)) in
  let vertex_lowlinks = ref StringMap.empty in

  Error.msg_debug (str "Tarjan's algorithm for schedules: " ++ str (String.concat ", " schedules) ++ fnl ());

  let rec strong_connect (v_name : string) =
    (* Assign discovery index and lowlink for v *)
    if StringMap.mem v_name !vertex_indices then () else begin 
    Error.msg_debug (str "Strong connecting " ++ str v_name ++ fnl ());
    vertex_indices := StringMap.add v_name !index !vertex_indices;
    vertex_lowlinks := StringMap.add v_name !index !vertex_lowlinks;
    in_stack.(!index) <- true;
    (* Feedback.msg_notice (str ("Pushing " ^ v_name) ++ fnl ()); *)
    let (v, dependent_names) = try StringMap.find v_name !inductive_dependency_map with Not_found -> failwith ("strong_connect: Could not find " ^ v_name) in
    stack := v :: !stack;
    index := !index + 1;


    (* Process each dependent of v *)
    Error.msg_debug (str ("Processing " ^ (let ((vn,_,_,_,_),_,_) = v in vn) ^ " with dependents: " ^ String.concat ", " dependent_names) ++ fnl ());
    List.iter (fun w_name ->
      if not (StringMap.mem w_name !vertex_indices) then (
        strong_connect w_name;
        let low_v = StringMap.find v_name !vertex_lowlinks in
        let low_w = StringMap.find w_name !vertex_lowlinks in
        vertex_lowlinks := StringMap.add v_name (min low_v low_w) !vertex_lowlinks
      )
      else
        let idx_w = StringMap.find w_name !vertex_indices in
        if idx_w >= 0 && idx_w < Array.length in_stack && in_stack.(idx_w) then (
        let low_v = StringMap.find v_name !vertex_lowlinks in
        vertex_lowlinks := StringMap.add v_name (min low_v idx_w) !vertex_lowlinks
        )
    ) dependent_names;

    (* If v is a root node, pop the stack to form an SCC *)
    if StringMap.find v_name !vertex_lowlinks = StringMap.find v_name !vertex_indices then (
      let rec pop_until acc =
        match !stack with
        | [] -> failwith "strong_connect: stack should not be empty"
        | w :: rest ->
            let w_name = let ((name,_,_,_,_),_,_) = w in name in
            Error.msg_debug (str ("Popping " ^ w_name) ++ fnl ());
            stack := rest;
            (* Feedback.msg_notice (str ("Popping " ^ w_name) ++ fnl ()); *)
            in_stack.(StringMap.find w_name !vertex_indices) <- false;
            (* Feedback.msg_notice (str ("Adding " ^ w_name ^ " to component") ++ fnl ()); *)
            let acc' = w :: acc in
            if w_name = v_name then acc'
            else pop_until acc'
      in
      let component = pop_until [] in
      Error.msg_debug (str ("Adding component: " ^ String.concat ", " (List.map (fun ((name,_,_,_,_),_,_) -> name) component)) ++ fnl ());
      components := component :: !components
    )
    end
  in

  List.iter strong_connect schedules;
  let component_sizes = List.map List.length !components in
  msg_debug (str "Component sizes: " ++ str (String.concat ", " (List.map string_of_int component_sizes)) ++ fnl ());
  List.map (fun component ->
    let names = List.map (fun ((name,_,_,_,_),_,_) -> name) component in
    List.map (fun (schedule, ds, constrained) ->
      insert_mutrec_calls_inductive_schedule ~within:names schedule, ds, constrained) component)
    (let components = propagate_schedule_requirements (List.rev !components) in
     List.iter (List.iter (fun ((name,_,_,_,_) as schedule, ds, constrained) ->
       let ind, outputs, _, _ = parse_ind_schd_name name in
       let entry = match InductiveScheduleKeyMap.find_opt (ind, outputs, ds, constrained) !density_inductive_memo with
         | Some (DensityDone ((_, density), cycle_independent, budget)) ->
           DensityDone ((schedule, density), cycle_independent, budget)
         | Some (DensityInProgress (_, density)) ->
           DensityInProgress (schedule, density)
         | None -> DensityDone ((schedule, Checking), false, None) in
       density_inductive_memo := InductiveScheduleKeyMap.add (ind, outputs, ds, constrained) entry !density_inductive_memo)) components;
     components)

let valid_schedules =
  Proofview.Goal.enter begin fun gl ->
    let c = Proofview.Goal.concl gl in
    let e = Proofview.Goal.env gl in
    let evd = Proofview.Goal.sigma gl in
    with_schedule_context e evd (fun () -> with_fresh_density_memo (fun () ->
    match NewGenericLib.parse_dependent_type (EConstr.to_constr evd c) with
    | Some dt -> 
      begin
        let schedules = NewUnifyQC.type_to_schedules ?select_groups:(grouped_selector D_Thm)
          dt None None [] [] D_Thm false in
        let schedules' = List.map (fun ((steps, sort), ms, eqs) -> (List.map (fun (v,p) -> S_Match (v,p)) ms, (List.map check_eq eqs @ steps, sort))) schedules in
        let schedules_w_densities = List.mapi (fun i (ms_steps, schd) -> i, schedule_density ms_steps schd) schedules' in
        let sorted = sort_schedules_by_density_and_var_uses schedules_w_densities D_Thm in

        if !NewGenericLib.debug_mode then begin
          Feedback.msg_notice (str "Printing all bindings" ++ fnl ());
          List.iteri (fun i ((steps_ds, sort), density, num_var_uses, id) ->
            Feedback.msg_notice (str ("sorted id: " ^ string_of_int i ^ " orig id: " ^ string_of_int id ^ ":\n" ) ++ fnl ());
            Feedback.msg_notice (str ("# var uses: " ^ string_of_int num_var_uses ^ "; density:" ^ density_to_string density ^ "\n") ++
                                str (schedule_with_densities_to_string (steps_ds, sort) ^ "\n") (*++  *)
                                (* str "\nconstrexpr: \n" ++  *)
                                (* NewUnifyQC.match_schedule_as_pp_constr_expr (List.map fst steps_ds, sort) [] [] D_Thm *)
                                                            ++ str "\n==============================================\n")) sorted
        end;
        Tacticals.tclIDTAC
      end 
    | None -> failwith "Failed to Parse type"))
  end

let theorem_dependencies = 
  Proofview.Goal.enter begin fun gl ->
    
    (* Convert goal to a constr_expr *)
    let c = Proofview.Goal.concl gl in
    let e = Proofview.Goal.env gl in
    let evd = Evd.from_env e in

    match NewGenericLib.parse_dependent_type (EConstr.to_constr evd c) with
    | Some dt ->
      begin
        msg_debug (str (NewGenericLib.rocq_constr_to_string dt) ++ fnl ());
        let open NewGenericLib in
        let rec printlist : (var * (int * int list list) list) list -> unit = function
          | [] -> ()
          | (var, rels) :: rest ->
            let path_to_string (is : int list) = "[" ^ String.concat ", " (List.map string_of_int is) ^ "]" in
            let paths_to_string (iss : int list list) = "{" ^ String.concat "; " (List.map path_to_string iss) ^ "}" in
            let tuple_to_string ((i : int), (j : int list list)) = "(" ^ string_of_int i ^ ", " ^ paths_to_string j ^ ")" in
            msg_debug (str (var_to_string var) ++ str " : " ++ str (String.concat ", " (List.map (fun (i, j) -> (tuple_to_string (i, j))) rels)) ++ fnl ()); 
            printlist rest in
        
        printlist (NewGenericLib.rocq_constr_var_relation_uses' dt);          
        Tacticals.tclIDTAC
      end
    | None -> failwith "Failed to Parse type"
  end

  let schedules =
    Proofview.Goal.enter begin fun gl ->
    
      (* Convert goal to a constr_expr *)
      let c = Proofview.Goal.concl gl in
      let e = Proofview.Goal.env gl in
      let evd = Evd.from_env e in
  
      match NewGenericLib.parse_dependent_type (EConstr.to_constr evd c) with
      | Some dt ->
        begin
          density_memo := RelationInstMap.empty;
          clear_inductive_name_cache ();
          clear_schedule_instance_cache ();
          msg_debug (str (NewGenericLib.rocq_constr_to_string dt) ++ fnl ());
          let scheds = NewUnifyQC.type_to_schedules ?select_groups:(grouped_selector D_Thm)
            dt None None [] [] D_Thm false in

          List.iteri (fun i (sch,ms,eqs) -> Feedback.msg_notice (str (string_of_int i) 
                                                          ++ str ":\n" 
                                                          ++ str (NewUnifyQC.match_schedule_to_string sch ms eqs) 
                                                          ++ str "\nconstrexpr: \n"
                                                          ++ (NewUnifyQC.match_schedule_as_pp_constr_expr sch ms eqs D_Thm)
                                                          ++ str "\n\n===================\n" 
                                                          ++ fnl ())) scheds;
          
          Tacticals.tclIDTAC
        end
      | None -> failwith "Failed to Parse type"
    end

module VarSet = Set.Make(struct type t = var let compare = compare end)
  
let defined_set = ref VarSet.empty


let is_defined_global (id : Names.Id.t) : bool =
  let qualid = Libnames.qualid_of_ident id in
  try
    ignore (Nametab.locate qualid);
    true
  with Not_found ->
    false

(* Check if name is defined in local goal context *)
let is_defined_local (id : Names.Id.t) env : bool =
  let hyps = Environ.named_context env in
  List.exists
    (function
      | Context.Named.Declaration.LocalAssum (id', _)
      | Context.Named.Declaration.LocalDef (id', _, _) ->
          Names.Id.equal id (Context.binder_name id'))
    hyps


(* Combined check: name is used anywhere *)
let is_name_in_use (id : Names.Id.t) env : bool =
  is_defined_local id env || is_defined_global id

let definition_poly () =
#if COQ_VERSION >= (9, 2, 0)
  PolyFlags.default
#else
  Attributes.is_universe_polymorphism ()
#endif

(* During tactic preparation, collect declarations to move into the proof's
   local context. Explicit derivations leave this unset and remain global. *)
let proof_definitions = ref None
let public_declaration_names = ref None
let public_instances = ref None

let emitted_name name = match !public_declaration_names with
  | None -> name
  | Some names -> (try Names.Id.Map.find name !names with Not_found -> name)

let define ?(implicit_binders=false) c name _env _evd =
  let c = match !public_declaration_names with
    | None -> c | Some names -> Constrexpr_ops.replace_vars_constr_expr !names c in
  let name = emitted_name name in
  let env = schedule_env () in
  let evd = schedule_sigma env in
  let declare name =
    let evd, (body, impargs) = Constrintern.interp_constr_evars_impls env evd c in
    let body = inline_schedule_definitions evd body in
    let cinfo = Declare.CInfo.make ~name ~typ:None
      ?impargs:(if implicit_binders then Some impargs else None) () in
    let info = Declare.Info.make ~poly:(definition_poly ()) () in
    let reference = Declare.declare_definition ~info ~cinfo ~opaque:false ~body evd in
    match !proof_definitions with
    | None -> ()
    | Some (definitions, universes) ->
        definitions := (name, reference) :: !definitions;
        universes := Univ.ContextSet.union !universes (Evd.universe_context_set evd)
  in
  if name = var_of_string "theorem" then
    declare (Namegen.next_ident_away_from (Names.Id.of_string "theorem")
      (fun id -> is_name_in_use id env))
  else if is_name_in_use name env then
    CErrors.user_err (str ("QuickChick cannot declare " ^ var_to_string name ^ ": the name is already in use."))
  else begin
    declare name;
    defined_set := VarSet.add name !defined_set
  end

let define_all schedule_pieces =
  List.iter (function
  | [] -> failwith "Empty piece"
  | [(name, constr)] -> 
    let e' = Global.env () in
    let evd' = Evd.from_env e' in
    Error.msg_debug (str ("Defining " ^ var_to_string name) ++ fnl ());
    Error.msg_debug (str ("Defining " ^ constr_expr_to_string constr) ++ fnl ());
    ignore (define constr name e' evd')
  | pieces -> 
    let e' = Global.env () in
    let evd' = Evd.from_env e' in
    List.iter (fun (name, constr) -> 
      Error.msg_debug (str ("Defining " ^ var_to_string name) ++ fnl ());
      Error.msg_debug (str ("Defining " ^ constr_expr_to_string constr) ++ fnl ());
      ignore (define constr name e' evd')) pieces
        ) schedule_pieces

(* Register the class represented by each compiled schedule. The helper keeps
   its size-first interface; the instance moves size into the class method. *)
let register_schedule_instances ~local components =
  let open NewGenericLib in
  List.iter (List.iter (fun ((name, inputs, param_deps, _, _), ds, constrained) ->
    if ds <> D_Thm then begin
      let ind, output_indices, _, _ = parse_ind_schd_name name in
      let helper_name = Names.Id.to_string (emitted_name (Names.Id.of_string name)) in
      let dependencies = List.concat_map (fun (_, classes) ->
        List.map (fun ty -> make_up_name_str "qc_instance_arg", ty) classes) param_deps in
      let binders = inputs @ dependencies in
      let method_size = make_up_name_str "qc_size" in
      let method_body = MFun ([PVar method_size, Some (MConst "Coq.Init.Datatypes.nat")],
        MApp (MConst helper_name, MId method_size :: List.map (fun (v, _) -> MId v) binders)) in
      let constructor, class_args = match ds, constrained with
      | D_Check, _ ->
          let predicate = MTyCtr (ind, List.map (fun (v, _) -> MId v) inputs) in
          "QuickChick.Decidability.Build_DecOpt", [predicate]
      | (D_Gen | D_Enum), false ->
          let ty = MTyCtr (ind, List.map (fun (v, _) -> MId v) inputs) in
          let cls = if ds = D_Gen then "GenSized" else "EnumSized" in
          "QuickChick.Classes.Build_" ^ cls, [ty]
      | (D_Gen | D_Enum), true ->
          let remaining_inputs = ref inputs in
          let outputs = ref [] in
          let arguments = List.init (List.length inputs + List.length output_indices) (fun i ->
            if List.mem i output_indices then begin
              let v = make_up_name_str "qc_output" in
              outputs := !outputs @ [v]; MId v
            end else match !remaining_inputs with
            | (v, _) :: rest -> remaining_inputs := rest; MId v
            | [] -> CErrors.anomaly (str "Missing schedule input")) in
          let pattern, annotation = match !outputs with
          | [] -> PWild, Some (MConst "Coq.Init.Datatypes.unit")
          | first :: rest ->
              List.fold_left (fun p v -> PCtr (constructor_of_string "Coq.Init.Datatypes.pair",
                [PWild; PWild; p; PVar v])) (PVar first) rest, None in
          let predicate = MFun ([pattern, annotation], MTyCtr (ind, arguments)) in
          let cls = if ds = D_Gen then "GenSizedSuchThat" else "EnumSizedSuchThat" in
          "QuickChick.DependentClasses.Build_" ^ cls, [MHole; predicate]
      | D_Thm, _ -> assert false in
      let binder kind (v, ty) =
        Constrexpr.CLocalAssum ([CAst.make (Names.Name v)],
#if COQ_VERSION >= (8, 20, 0)
          None,
#endif
          kind, mexp_to_constr_expr ty ds) in
      (* Classify inputs from the elaborated helper type, not their spelling.
         This also handles class dictionaries that are parameters of the relation. *)
      let env = Global.env () in
      let sigma, helper = Evd.fresh_global env (Evd.from_env env)
        (Nametab.locate (Libnames.qualid_of_string helper_name)) in
      let sigma, helper_type = Typing.type_of env sigma helper in
      let rec input_kinds count typ =
        if count = 0 then [] else match EConstr.kind sigma typ with
        | Constr.Prod (_, dom, body) ->
          let kind = if Typeclasses.is_class_type sigma dom then
              Constrexpr.Generalized (Glob_term.MaxImplicit, false)
            else Constrexpr.Default
              (if EConstr.isSort sigma dom then Glob_term.MaxImplicit else Glob_term.Explicit) in
          kind :: input_kinds (count - 1) body
        | _ -> CErrors.anomaly (str "Missing scheduled helper argument") in
      let kinds = List.tl (input_kinds (1 + List.length inputs) helper_type) in
      let class_binder = binder (Constrexpr.Generalized (Glob_term.MaxImplicit, false)) in
      let body = mexp_to_constr_expr
        (MApp (MConst constructor, class_args @ [method_body])) ds in
      let binders = List.map2 binder kinds inputs @ List.map class_binder dependencies in
      let body = if binders = [] then body else CAst.make (Constrexpr.CLambdaN (binders, body)) in
      let instance_name = fresh_name (helper_name ^ "_instance") in
      let env = Global.env () in
      define ~implicit_binders:true body instance_name env (Evd.from_env env);
      let reference = Nametab.locate (Libnames.qualid_of_ident instance_name) in
      (match !public_instances with
      | None -> ()
      | Some instances -> instances := (name, reference) :: !instances);
      Classes.existing_instance (if local then Hints.Local else Hints.SuperGlobal)
        reference (Some { Typeclasses.hint_priority = Some 42; hint_pattern = None })
    end)) components

(* Dependencies precede their consumers. Register each SCC before elaborating
   the next one so external calls use the ordinary class projections. *)
let define_schedule_components ~local components pieces =
  (match !public_declaration_names with
  | None -> ()
  | Some names -> List.iter (List.iter (fun (name, _) ->
      names := Names.Id.Map.add name (fresh_name (Names.Id.to_string name)) !names)) pieces);
  List.iter2 (fun component definitions ->
    define_all [definitions];
    register_schedule_instances ~local [component]) components pieces

let derive_schedule ind ois ds opt =
  match NewGenericLib.ind_reference_to_rocq_relations ind with
    | Some (idx, rs) ->
      reset_density_inductive_memo ();
      inductive_set := inductive_set_init;
      rocq_relation_memo := TyCtrMap.empty;
      (* inductive_dependency_map := StringMap.empty; *)
      let (ind_name, params, constructors, result_typ) = List.nth rs idx in
      msg_debug (str "Deriving inductive schedule for " ++ str (ty_ctr_to_string ind_name) ++ fnl ());
      let (inductive_schedule, density) = try
        inductive_best_valid_schedule (ind_name, params, constructors, result_typ) ois ds opt
      with
      | Noninductive_dependency name ->
        CErrors.user_err (str ("No scheduled instance can use the defined relation " ^
          ty_ctr_to_string name ^ " in this mode."))
      | Unavailable_mode constructor ->
        CErrors.user_err (str ("No usable scheduled mode for constructor " ^ constructor ^
          "; check the required dependency instances.")) in
      Error.msg_debug (str "Inductive Schedule:\n" ++ str (inductive_schedule_to_string inductive_schedule) ++ fnl ());
      msg_debug (str "Density: " ++ str (density_to_string density) ++ fnl ());
      density_inductive_memo := InductiveScheduleKeyMap.remove (ty_ctr_of_string "eq", [], D_Check, true) !density_inductive_memo;

      let ind_schd_name = match inductive_schedule with (n,_,_,_,_) -> n in
      complete_stable_closures ();
      let dependents, inductive_dependency_map = collect_all_used_inductive_schd_names ind_schd_name in

      let components = tarjan_schedules_by_name dependents inductive_dependency_map in

      let schedules_pieces = inductive_schedules_to_def_constr_exprs components ind_schd_name in

      define_schedule_components ~local:false components schedules_pieces;
      Feedback.msg_notice (int (List.length schedules_pieces) ++ str " Pieces defined" ++ fnl ())

    | None -> failwith "Failed to parse inductive type "

(* Public commands compile in a transaction so internal schedule names do not
   become a second public naming scheme or collide on repeated derivations. *)
let compile_public ~mode ~outputs ~constrained ~all_mutual ind =
  let ds = match mode with
    | "Gen" -> D_Gen | "Enum" -> D_Enum | "Check" -> D_Check
    | _ -> invalid_arg "compile_public mode" in
  let roots = match NewGenericLib.ind_reference_to_rocq_relations ind with
    | Some (index, roots) -> if all_mutual then roots else [List.nth roots index]
    | None -> CErrors.user_err (str "Expected an inductive datatype") in
  let initial = Evd.from_env (Global.env ()) in
  Vernacstate.System.protect (fun () ->
    let definitions = ref [] and universes = ref Univ.ContextSet.empty in
    let instances = ref [] and names = ref Names.Id.Map.empty in
    let old_definitions = !proof_definitions in
    let old_names = !public_declaration_names and old_instances = !public_instances in
    Fun.protect ~finally:(fun () ->
      proof_definitions := old_definitions;
      public_declaration_names := old_names; public_instances := old_instances) (fun () ->
      proof_definitions := Some (definitions, universes);
      public_declaration_names := Some names; public_instances := Some instances;
      let for_root root (name, _) =
        let ind, ois, mode, is_constrained = parse_ind_schd_name name in
        ind = root && mode = ds && is_constrained = constrained && ois = outputs in
      List.iter (fun (root, _, _, _) ->
        if not (List.exists (for_root root) !instances) then
          derive_schedule (CAst.make (Constrexpr.CRef (root, None))) outputs ds constrained) roots;
      let env = Global.env () in
      let constants = List.filter_map (fun (_, reference) -> match reference with
        | Names.GlobRef.ConstRef c -> Some c | _ -> None) !definitions in
      let rec expand term = match Constr.kind term with
        | Constr.Const (c, u) when List.exists (Names.Constant.equal c) constants ->
            expand (Environ.constant_value_in env (c, u))
        | _ -> Constr.map expand term in
      let new_levels = Univ.Level.Set.diff
        (Univ.ContextSet.levels !universes) (UGraph.domain (Evd.universes initial)) in
      let context = Univ.ContextSet.add_constraints (Univ.ContextSet.constraints !universes)
        (Univ.ContextSet.of_set new_levels) in
      List.fold_left (fun (sigma, bodies) (root, _, _, _) ->
        let _, reference = List.find (for_root root) !instances in
        let sigma, term = Evd.fresh_global env sigma reference in
        let body = EConstr.of_constr (expand (EConstr.to_constr sigma term)) in
        sigma, bodies @ [Libnames.qualid_basename root, body])
        (Evd.merge_context_set Evd.univ_rigid initial context, []) roots)) ()

let quickchick_it size idx =
  Proofview.Goal.enter_one begin fun gl ->
    let c = Proofview.Goal.concl gl in
    let e = Proofview.Goal.env gl in
    let evd = Proofview.Goal.sigma gl in
    
    let definitions = ref [] in
    let universes = ref Univ.ContextSet.empty in
    let prepare () = with_schedule_context e evd (fun () ->
    match NewGenericLib.parse_dependent_type (EConstr.to_constr evd c) with
    | Some dt -> 
      begin
        msg_debug (str (NewGenericLib.rocq_constr_to_string dt) ++ fnl ());
        let open NewGenericLib in 
        reset_density_inductive_memo ();
        inductive_set := inductive_set_init;
        rocq_relation_memo := TyCtrMap.empty;

        let e' = Global.env () in

        (* Index 0 needs only the best schedule; other indices need the full ranking. *)
        let theorem_schedules = all_theorem_schedules ~best_only:(idx = 0) dt in

        let selected_schedule = 
          (match List.nth_opt theorem_schedules idx with
          | Some (schd, _, _, inductive_memo, density_memo_after) ->
            density_inductive_memo := inductive_memo;
            density_memo := density_memo_after;
            schd
          | None -> CErrors.user_err (str (Printf.sprintf
              "quickchick: schedule index %d was requested, but only %d theorem schedule%s available."
              idx (List.length theorem_schedules)
              (if List.length theorem_schedules = 1 then " is" else "s are")))) in

        (* let theorem_schedule = best_theorem_schedule dt in *)
        Feedback.msg_notice (str "Theorem Schedule:\n" ++ str (schedule_to_string selected_schedule) ++ fnl ());

        (* Register theorem as a phony inductive schedule *)
        let phony_theorem_ind_schd = ("theorem", [], [],[selected_schedule,[],[]],[]) in
        density_inductive_memo := InductiveScheduleKeyMap.add (ty_ctr_of_string "theorem", [], D_Thm, true) (DensityDone ((phony_theorem_ind_schd, Checking), true, None)) !density_inductive_memo;

        density_inductive_memo := InductiveScheduleKeyMap.remove (ty_ctr_of_string "eq", [], D_Check, true) !density_inductive_memo;
        (* let (unconstrained_inductives, mut_used_inductives) = collect_all_used_inductives_theorem theorem_schedule in *)
        complete_stable_closures ();
        let dependents, inductive_dependency_map = collect_all_used_inductive_schd_names "theorem" in
        Error.msg_debug (str "Dependents: " ++ str (String.concat ", " dependents) ++ fnl ());
        let components = tarjan_schedules_by_name dependents inductive_dependency_map in

        let ind_schd_name = "theorem" in

        Error.msg_debug (str ("Components: " ^ string_of_int (List.length components)) ++ fnl ());
        let schedules_pieces = inductive_schedules_to_def_constr_exprs components ind_schd_name in

        Feedback.msg_notice (str "Pieces: " ++ fnl ());
        List.iter (List.iter (fun (name, constr) -> Error.msg_debug (str (var_to_string name ^ ": ") ++ str (constr_expr_to_string constr) ++ fnl ()))) schedules_pieces;

        let theorem_constr = 
          begin match List.find_opt (function [(name, _)] -> name = var_of_string "theorem" | _ -> false) schedules_pieces with
          | Some [(_, constr)] -> constr
          | None -> failwith "quickchick_it: Could not find theorem in schedules pieces"
          end in


        define_schedule_components ~local:true components schedules_pieces;

        defined_set := VarSet.empty;

        let c_theorem = theorem_constr in
        (* msg_debug (str "After constrained generator" ++ fnl ());*)
        let updated_env = schedule_env () in
        let updated_evd = schedule_sigma updated_env in
        let rec int_to_num i = 
          if i = 0 then c_zero
          else c_succ (int_to_num (i - 1))
        in
        msg_debug (str "Running QuickCheck" ++ fnl ());
        let size_thm =
          begin match size with
          | Some s -> c_app ~explicit:false c_theorem [int_to_num s]
          | None -> c_sized c_theorem
          end  in 
        (* Feedback.msg_notice (str "added size" ++ fnl ()); *)
        let (run_evd, to_run) =
          Constrintern.interp_constr_evars updated_env updated_evd
            (c_show (c_quickCheck size_thm)) in
        let to_run = inline_schedule_definitions run_evd to_run in
        #if COQ_VERSION >= (8, 20, 0)
          (* FRAGILE probably won't be allowed in the future? *)
          let opaque_access = Library.indirect_accessor[@@warning "-3"] in
          QuickChick.define_and_run ~opaque_access to_run updated_env run_evd;
  #else
          QuickChick.define_and_run to_run updated_env run_evd;
  #endif
        (* let _ = (QuickChick.define_and_run  to_run updated_env run_evd) in *)
        Tacticals.tclIDTAC
        (* end  *)
      end
    | None -> failwith "Failed to Parse type") in
    let previous = !proof_definitions in
    let sigma, definitions = Vernacstate.System.protect (fun () ->
      Fun.protect ~finally:(fun () -> proof_definitions := previous) (fun () ->
        proof_definitions := Some (definitions, universes);
        ignore (prepare ());
        let env = Global.env () in
        let constants = List.filter_map (fun (_, reference) -> match reference with
          | Names.GlobRef.ConstRef c -> Some c | _ -> None) !definitions in
        (* Expand only this preparation's constants, including dependencies.
           Local lets then carry no references to discarded global declarations. *)
        let rec expand term = match Constr.kind term with
          | Constr.Const (c, u) when List.exists (Names.Constant.equal c) constants ->
              expand (Environ.constant_value_in env (c, u))
          | _ -> Constr.map expand term in
        let new_levels = Univ.Level.Set.diff
          (Univ.ContextSet.levels !universes) (UGraph.domain (Evd.universes evd)) in
        let universe_context = Univ.ContextSet.add_constraints
          (Univ.ContextSet.constraints !universes) (Univ.ContextSet.of_set new_levels) in
        List.fold_left (fun (sigma, acc) (name, reference) ->
          let sigma, term = Evd.fresh_global env sigma reference in
          let body = expand (EConstr.to_constr sigma term) in
          sigma, acc @ [name, EConstr.of_constr body])
          (Evd.merge_context_set Evd.univ_rigid evd universe_context, [])
          (List.rev !definitions))) () in
    Proofview.tclTHEN (Proofview.Unsafe.tclEVARS sigma)
      (List.fold_left (fun tactic (name, body) ->
        Proofview.tclTHEN tactic (Tactics.pose_tac (Names.Name name) body))
        Tacticals.tclIDTAC definitions)
  end

(*This tactic uses the quickchick_it tactic to run all possible indices with size None, capturing the Message output and putting it into a file in the 
current directory*)

(* This tactic uses the quickchick_it tactic to run all possible indices with size None,
   capturing the Message output and putting it into a file in the current directory *)


   open Proofview.Notations
   open Proofview
   open Feedback

let capture_output tac : unit Proofview.tactic =
  let file = open_out_gen [Open_creat; Open_text; Open_append] 0o666 "quickchick_run_output.txt" in


  let feedback_hook fb =
    match fb.contents with
    | Feedback.Message (_lvl, _, ppcmds) ->
        let s = Pp.string_of_ppcmds ppcmds in
        output_string file (s ^ "\n"); flush file
    | _ -> () 
    in
  
  let id = Feedback.add_feeder feedback_hook in
  output_string file "OUTSTART:::\n";
  Printf.printf "Hook installed: %d\n" id;
  tac >>= fun () ->
  output_string file "OUTEND:::\n";
  Feedback.del_feeder id;
  close_out file;
  Proofview.tclUNIT ()

let try_all_quickchick_schedules : unit Proofview.tactic =
   (* Storage for captured messages *)
   let captured_output = ref [] in
   

    let feedback_hook fb =
      match fb.contents with
      | Feedback.Message (_lvl, _, ppcmds) ->
          let s = Pp.string_of_ppcmds ppcmds in
          (*Print captured message to file*)



          captured_output := s :: !captured_output
      | _ -> () in
    

    let run_all_quickchick_it (max_index : int) : unit Proofview.tactic =
      (let id = Feedback.add_feeder feedback_hook in
    
      let rec loop i =
        if i > max_index then tclUNIT ()
        else
          (* Call the existing tactic here *)
          quickchick_it None i >>= fun () ->
          (* Capture output *)
          loop (i + 1)
      in
    
      loop 0 >>= fun () ->
      Feedback.del_feeder id; 
      (
        let oc = open_out "quickchick_run_output.txt" in
        List.iter (fun s -> output_string oc (s ^ "\n")) (List.rev !captured_output);
        close_out oc
      ); 
      Proofview.tclUNIT ())
      in

    run_all_quickchick_it 48 (* Adjust the max index as needed *)
 
}
TACTIC EXTEND quickchick
  | ["quickchick" int_list(ois)] -> { 
    match ois with
    | sz :: idx :: _ -> quickchick_it (Some sz) idx
    | x :: _ -> quickchick_it (Some x) 0
    | [] -> quickchick_it None 0}
END

TACTIC EXTEND quickchick_idx
  | ["quickchick_idx" int(idx)] -> { quickchick_it None idx }
END

TACTIC EXTEND try_all_quickchick_schedules
  | ["try_all_quickchick_schedules"] -> { try_all_quickchick_schedules }
END

TACTIC EXTEND capture_output 
  | ["capture_output" tactic(tac)] -> { 
    capture_output (Tacinterp.tactic_of_value (default_ist ()) tac) }
END

TACTIC EXTEND schedules 
  | ["schedules"] -> { schedules }
END

TACTIC EXTEND theorem_dependencies
  | ["theorem_dependencies"] -> { theorem_dependencies }
END

TACTIC EXTEND valid_schedules
  | ["valid_schedules"] -> { valid_schedules }
END

VERNAC COMMAND EXTEND Print CLASSIFIED AS SIDEFF
 | ["Print" "Typeclasses" "for" ident(ind)] ->
    { let ind' = Libnames.qualid_of_ident ind in 
      ignore (NewGenericLib.find_typeclass_bindings ind') }
END

(*type rocq_relation
  = ty_ctr        (* The name of the relation (e.g. IsSorted) *)
  * ty_param list (* The list of type parameters (e.g. "t" in IsSorted) *)
  * rocq_ctr list (* A list of constructors. Each constructor is a pair (name, type) *)
  * rocq_constr   (* The type of the overall relation (e.g. "list t -> Prop") *)*)

VERNAC COMMAND EXTEND DeriveSchedules CLASSIFIED AS SIDEFF
   | ["Derive" "Schedules" constr(ind) int_list(ois) "consnum" int(ctr_idx) "derive" string(ds)] ->
    { match NewGenericLib.ind_reference_to_rocq_relations ind with
    | Some (idx, rs) -> 
      let open NewGenericLib in
      let (ind_name, params, constructors, result_typ) = List.nth rs idx in

      (* Feedback.msg_notice (str "Inductive name: " 
                        ++ str (ty_ctr_to_string ind_name)
                        ++ str "\n Parameters: "
                        ++ str (String.concat ", " (List.map ty_param_to_string params)) 
                        ++ str "\n Result Type: "
                        ++ str (rocq_constr_to_string result_typ) 
                        ++ str "\n Output indices: "
                        ++ str (String.concat ", " (List.map string_of_int ois)) 
                        ++ str ("\n Derive Sort: " ^ ds) 
                        ++ str "\n\n"); *)
      let ds_string = ds in 
      let ds = (match ds with
      | "Check" -> D_Check
      | "Gen" -> D_Gen
      | "Thm" -> D_Thm
      | "Enum" -> D_Enum
      | _ -> failwith ("Invalid derive sort " ^ ds)) in


      let rec get_result_vars = function
      | DProd ((v,t), b) ->
        let v = make_up_name_str ("v_" ^ var_to_string v) in
        (v,t) :: get_result_vars b
      | DArrow (t1, t2) ->
        let v = make_up_name_str "v" in
        (v,t1) :: get_result_vars t2
      | _ -> [] in

      let dtype = DTyCtr (ty_ctr_of_string "Type", []) in

      let result_vars = List.map (fun p -> (p, dtype)) params @ get_result_vars result_typ in

      let rec remake_result vars result = 
        match vars, result with
        | [], _ -> result
        | (v,t) :: rest, DProd  (_, t') 
        | (v,t) :: rest, DArrow (_, t') -> DProd ((v,t), remake_result rest t')
        | _ -> failwith "remake_result failed" in

      let (ctr, constructor) = List.nth constructors ctr_idx in

      let output_vars = List.map fst (List.filteri (fun i _ -> List.mem i ois) result_vars) in

      let scheds = NewUnifyQC.type_to_schedules ?select_groups:(grouped_selector ds) constructor (Some ind_name) (Some ctr) result_vars output_vars ds true in
      
      let rec take n l =
        if n <= 0 then [] else
        match l with
        | [] -> []
        | x :: xs -> x :: take (n - 1) xs in

      let rec drop n l =
        if n <= 0 then l else
        match l with
        | [] -> []
        | x :: xs -> drop (n - 1) xs in

      Feedback.msg_notice (str "Inductive name: " 
                        ++ str (ty_ctr_to_string ind_name) 
                        ++ str "\n Constructor Name: " 
                        ++ str (ty_ctr_to_string ctr)
                        ++ str "\n Parameters: "
                        ++ str (String.concat ", " (List.map ty_param_to_string params))
                        ++ str "\n Constructor Type: "
                        ++ str (NewGenericLib.rocq_constr_to_string constructor)
                        ++ str "\n Result Type: "
                        ++ str (NewGenericLib.rocq_constr_to_string (remake_result (drop (List.length params) result_vars) result_typ))
                        ++ str "\n Output indices: "
                        ++ str (String.concat ", " (List.map string_of_int ois)) 
                        ++ str ("\n Derive Sort: " ^ ds_string) 
                        ++ str "\n\n");

      List.iteri (fun i (sch,ms,eqs) -> Feedback.msg_notice (str (string_of_int i) 
                                                          ++ str ":\n" 
                                                          ++ str (NewUnifyQC.match_schedule_to_string sch ms eqs) 
                                                          ++ str "\nconstrexpr: \n"
                                                          ++ (NewUnifyQC.match_schedule_as_pp_constr_expr sch ms eqs ds)
                                                          ++ str "\n\n===================\n" 
                                                          ++ fnl ())) (take 300 scheds) 
    | None -> failwith "Failed to parse inductive type" 
    }
END

VERNAC COMMAND EXTEND DeriveValidSchedules CLASSIFIED AS SIDEFF
   | ["Derive" "Valid" "Schedules" constr(ind) int_list(ois) "consnum" int(ctr_idx) "derive" string(ds)] ->
    { match NewGenericLib.ind_reference_to_rocq_relations ind with
    | Some (idx, rs) -> 
      let open NewGenericLib in
      let (ind_name, params, constructors, result_typ) = List.nth rs idx in
      reset_density_inductive_memo ();
      Feedback.msg_notice (str "Inductive name: " 
                        ++ str (ty_ctr_to_string ind_name)
                        ++ str "\n Parameters: "
                        ++ str (String.concat ", " (List.map ty_param_to_string params)) 
                        ++ str "\n Result Type: "
                        ++ str (rocq_constr_to_string result_typ) 
                        ++ str "\n Output indices: "
                        ++ str (String.concat ", " (List.map string_of_int ois))
                        ++ str ("\n Derive Sort: " ^ ds) 
                        ++ str "\n\n");

      let ds = (match ds with
      | "Check" -> D_Check
      | "Gen" -> D_Gen
      | "Thm" -> D_Thm
      | "Enum" -> D_Enum
      | _ -> failwith ("Invalid derive sort " ^ ds)) in

      let rec get_result_vars = function
      | DProd ((v,t), b) ->
        let v = make_up_name_str ("v_" ^ var_to_string v) in
        (v,t) :: get_result_vars b
      | DArrow (t1, t2) ->
        let v = make_up_name_str "v" in
        (v,t1) :: get_result_vars t2
      | _ -> [] in

      let result_vars = List.map (fun v -> (v,DHole)) params @ get_result_vars result_typ in

      let rec remake_result vars result = 
        match vars, result with
        | [], _ -> result
        | (v,t) :: rest, DProd  (_, t') 
        | (v,t) :: rest, DArrow (_, t') -> DProd ((v,t), remake_result rest t')
        | _ -> failwith ("remake_result failed on: " ^ rocq_constr_to_string result) in

      let (ctr, constructor) = List.nth constructors ctr_idx in

      let output_vars = List.map fst (List.filteri (fun i _ -> List.mem i ois) result_vars) in

      let rec take n l =
        if n <= 0 then [] else
        match l with
        | [] -> []
        | x :: xs -> x :: take (n - 1) xs in

      let rec drop n l =
        if n <= 0 then l else
        match l with
        | [] -> []
        | x :: xs -> drop (n - 1) xs in

      Feedback.msg_notice (str "Inductive name: " 
                        ++ str (ty_ctr_to_string ind_name) 
                        ++ str "\n Constructor Name: " 
                        ++ str (ty_ctr_to_string ctr)
                        ++ str "\n Parameters: "
                        ++ str (String.concat ", " (List.map ty_param_to_string params))
                        ++ str "\n Constructor Type: "
                        ++ str (NewGenericLib.rocq_constr_to_string constructor)
                        ++ str "\n Result Type: "
                        ++ str (NewGenericLib.rocq_constr_to_string (remake_result (drop (List.length params) result_vars) result_typ))
                        ++ str "\n Output indices: "
                        ++ str (String.concat ", " (List.map string_of_int ois)) 
                        ++ str "\n\n");

      density_memo := RelationInstMap.empty;
      clear_inductive_name_cache ();
      clear_schedule_instance_cache ();
      Feedback.msg_notice (str "Printing all bindings" ++ fnl ());
      let schedules_w_densities =
        match Sys.getenv_opt "QC_SCHEDULE_SCORE_PRUNING" with
        | Some ("1" | "true" | "yes" | "verify" | "baseline") ->
          (fun (_, scored, _) -> scored) (constructor_valid_schedules ind_name (ctr, constructor)
            result_vars output_vars ds true)
          |> List.map (fun (i, scored, _, _) -> i, scored)
          |> take 300
        | _ ->
          let scheds = NewUnifyQC.type_to_schedules ?select_groups:(grouped_selector ds)
            constructor (Some ind_name) (Some ctr) result_vars output_vars ds true in
          let schedules = take 300 scheds in
          let schedules' = List.map (fun ((steps, sort), ms, eqs) ->
            (List.map (fun (v,p) -> S_Match (v,p)) ms,
             (List.map check_eq eqs @ steps, sort))) schedules in
          List.mapi (fun i (ms_steps, schd) ->
            i, schedule_density ms_steps schd) schedules' in
      let sorted = sort_schedules_by_density_and_var_uses schedules_w_densities ds in

      List.iter (fun ((steps_ds, sort), density, num_var_uses, id) ->

        Feedback.msg_notice (str (string_of_int id ^ ":\n" ) ++ fnl ());
        Feedback.msg_notice (str ("# var uses: " ^ string_of_int num_var_uses ^ "density:" ^ density_to_string density ^ "\n") ++
                            str (schedule_with_densities_to_string (steps_ds, sort) ^ "\n") ++                                           
                            str "\nconstrexpr: \n" ++ 
                            NewUnifyQC.match_schedule_as_pp_constr_expr (List.map fst steps_ds, sort) [] [] ds
                                                        ++ str "\n==============================================\n")) sorted

    | None -> failwith "Failed to parse inductive type" 
    }
END

      

VERNAC COMMAND EXTEND DeriveUsedInds CLASSIFIED AS SIDEFF
   | ["Derive" "Used" "Inds" constr(ind)] ->
    { match NewGenericLib.ind_reference_to_rocq_relations ind with
    | Some (idx, rs) ->
        let (ind_name, params, constructors, result_typ) = List.nth rs idx in
        (match get_inductive_name ind_name with
        | Some i -> print_type_names (List.map (fun (n,_,_,_) -> n) (seek_rocq_relations i))
        | None -> failwith "Failed to get inductive name")
    | None -> failwith "Failed to parse inductive type"  
    }
END

VERNAC COMMAND EXTEND DeriveDensity CLASSIFIED AS SIDEFF
   | ["Derive" "Density" constr(ind) int_list(ois) "derive" string(ds)] ->
    { match NewGenericLib.ind_reference_to_rocq_relations ind with
    | Some (idx, rs) ->
      (* density_memo := RelationInstMap.empty;
      let ds = (match ds with
      | "Check" -> D_Check
      | "Gen" -> D_Gen
      | "Thm" -> D_Thm
      | "Enum" -> D_Enum) in
      ignore (final_density (List.nth rs idx) ois true ds) *)
      reset_density_inductive_memo ();
      inductive_set := inductive_set_init;
      rocq_relation_memo := TyCtrMap.empty;
      (* inductive_dependency_map := StringMap.empty; *)
      let (ind_name, params, constructors, result_typ) = List.nth rs idx in
      let ds = (match ds with
      | "Check" -> D_Check
      | "Gen" -> D_Gen
      | "Enum" -> D_Enum
      | _ -> failwith "Can only derive inductive schedules for Check, Gen, or Enum") in
      let (inductive_schedule, density) = inductive_best_valid_schedule (ind_name, params, constructors, result_typ) ois ds true in
      (* Feedback.msg_notice (str "Inductive Schedule:\n" ++ str (inductive_schedule_to_string inductive_schedule) ++ fnl ()); *)
      Feedback.msg_notice (str "Density: " ++ str (density_to_string density) ++ fnl ())

    | None -> failwith "Failed to parse inductive type" 
    }
END

VERNAC COMMAND EXTEND DeriveInductiveSchedule CLASSIFIED AS SIDEFF
   | ["Derive" "Inductive" "Schedule" constr(ind) int_list(ois) "derive" string(ds) "opt" string(opt)] ->
    { let ds = match ds with
      | "Check" -> D_Check | "Gen" -> D_Gen | "Enum" -> D_Enum
      | _ -> CErrors.user_err (str "Expected Check, Gen, or Enum") in
      let opt = match opt with
      | "true" -> true | "false" -> false
      | _ -> CErrors.user_err (str "Opt must be true or false") in
      derive_schedule ind ois ds opt }
END

TACTIC EXTEND merge_sound_core
  | ["merge_sound_core"] -> { merge_sound }
END

TACTIC EXTEND remember_induct
  | ["remember_induct" ident(h)] -> { remember_induct h }
END
