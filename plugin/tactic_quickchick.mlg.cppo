let schedule_with_densities_to_string (s : schedule_with_density) =
  let (steps, sort) = s in
  Printf.sprintf "do %s \n=> %s\n" (String.concat " ;\n " (List.map (fun (step, density) -> schedule_step_to_string step ^ " " ^ density_to_string density) steps)) (schedule_sort_to_string sort)

let producer_sort_to_derive_sort (ps : producer_sort) : derive_sort =
  match ps with
  | PS_E -> D_Enum
  | PS_G -> D_Gen

let check_eq (u1,u2) = S_Check (SrcNonrec (DTyCtr (ty_ctr_of_string "Coq.Init.Logic.eq", [DHole; DTyVar u1; DTyVar u2])), true)

let rec arrows_to_products typ =
  match typ with
  | DArrow (t1, t2) -> 
    let name = make_up_name () in
    DProd ((name, t1), arrows_to_products t2)
  | DProd ((name, t1), t2) -> DProd ((name, t1), arrows_to_products t2)
  | _ -> typ

type schedule_ranking_policy = ScheduleRanking.policy =
  | RankDensityThenVars
  | RankDensityCountsThenVars
  | RankDensityOnly
  | RankVarsThenDensity
  | RankVarsOnly

let schedule_ranking_policy = ScheduleRanking.current
let schedule_ranking_policy_to_string = ScheduleRanking.to_string

let schedule_rank_derive_sort_to_string = function
  | D_Gen -> "Gen"
  | D_Enum -> "Enum"
  | D_Check -> "Check"
  | D_Thm -> "Thm"

let schedule_tie_report_enabled () =
  match Sys.getenv_opt "QC_SCHEDULE_TIE_REPORT" with
  | Some "1" | Some "true" | Some "yes" -> true
  | _ -> false

let schedule_trace_enabled () =
  match Sys.getenv_opt "QC_SCHEDULE_TRACE" with
  | Some "1" | Some "true" | Some "yes" -> true
  | _ -> false

let schedule_tie_report_limit () =
  match Sys.getenv_opt "QC_SCHEDULE_TIE_LIMIT" with
  | Some s -> (try max 0 (int_of_string s) with Failure _ -> 3)
  | None -> 3

let density_rank = function
  | Checking -> 0
  | Backtracking -> 1
  | Neutral -> 2
  | Partial -> 3
  | Total -> 4

let scored_schedule_features ds candidate_id ((steps, _) as scored) =
  let prefer_dense = ds = D_Gen || ds = D_Thm in
  let ranks = List.map (fun (_, grade) -> density_rank grade) steps in
  let density_rank = List.fold_left
    (if prefer_dense then min else max)
    (if prefer_dense then 4 else 0) ranks in
  { ScheduleRanking.density_rank;
    density_counts = ScheduleRanking.histogram_of_ranks ranks;
    variable_uses = get_num_var_uses scored ds;
    candidate_id }

(* The worst step density for the derivation direction. *)
let representative_density ds ((schd_steps, _) : schedule_with_density) =
  match ds with
  | D_Gen | D_Thm ->
    (match List.sort (fun (_,d) (_,d') -> compare d d') schd_steps with
     | (_,x) :: _ -> x
     | [] -> Total)
  | D_Enum | D_Check ->
    (match List.sort (fun (_,d) (_,d') -> - (compare d d')) schd_steps with
     | (_,x) :: _ -> x
     | [] -> Checking)

let sort_schedules_by_density_and_var_uses (schedules : (int * schedule_with_density) list) (ds : derive_sort) : (schedule_with_density * rule_density * int * int) list =
  let rec take_local n l =
    if n <= 0 then [] else
    match l with
    | [] -> []
    | x :: xs -> x :: take_local (n - 1) xs
  in
  let density_compare =
    match ds with
    | D_Gen | D_Thm -> fun d d' -> - (compare d d')
    | D_Enum | D_Check -> fun d d' -> compare d d'
  in
  let representative_density = representative_density ds in
  let entries = List.map (fun (i, (schd_steps,schd_sort)) ->
    let density = representative_density (schd_steps,schd_sort) in
    let num_var_uses = get_num_var_uses (schd_steps,schd_sort) ds in
    ((schd_steps,schd_sort), density, num_var_uses, i)) schedules
  in
  let policy = schedule_ranking_policy () in
  let count_by_id = Hashtbl.create (List.length entries) in
  if policy = RankDensityCountsThenVars then
    List.iter (fun ((steps, _), _, _, id) ->
      Hashtbl.add count_by_id id
        (ScheduleRanking.histogram_of_ranks
           (List.map (fun (_, density) -> density_rank density) steps))) entries;
  let counts id =
    if policy = RankDensityCountsThenVars then Hashtbl.find count_by_id id
    else ScheduleRanking.histogram_of_ranks [] in
  let features (_, density, variable_uses, candidate_id) =
    { ScheduleRanking.density_rank = density_rank density;
      density_counts = counts candidate_id; variable_uses; candidate_id } in
  let prefer_dense = ds = D_Gen || ds = D_Thm in
  let compare_entry a b =
    ScheduleRanking.compare ~prefer_dense policy (features a) (features b) in
  let sorted = List.sort compare_entry entries in
  if schedule_trace_enabled () then begin
    match sorted with
    | [] ->
      Feedback.msg_notice
        (str (Printf.sprintf
          "[schedule-ranking] policy=%s derive=%s candidates=0 selected=none\n"
          (schedule_ranking_policy_to_string policy)
          (schedule_rank_derive_sort_to_string ds)))
    | ((steps_ds, sort), density, num_var_uses, id) :: _ ->
      Feedback.msg_notice
        (str (Printf.sprintf
          "[schedule-ranking] policy=%s derive=%s candidates=%d selected-id=%d selected-density=%s selected-var-uses=%d%s\n"
          (schedule_ranking_policy_to_string policy)
          (schedule_rank_derive_sort_to_string ds)
          (List.length entries)
          id
          (density_to_string density)
          num_var_uses
          (if policy = RankDensityCountsThenVars then
             " selected-counts=" ^ ScheduleRanking.histogram_to_string (counts id)
           else ""))
         ++ str (schedule_with_densities_to_string (steps_ds, sort)))
  end;
  if schedule_tie_report_enabled () && List.length entries > 1 then begin
    let primary_key =
      match policy with
      | RankDensityThenVars | RankDensityCountsThenVars | RankDensityOnly -> fun (_,d,_,_) -> density_to_string d
      | RankVarsThenDensity | RankVarsOnly -> fun (_,_,v,_) -> string_of_int v
    in
    let secondary_report es =
      match policy with
      | RankDensityCountsThenVars ->
        let histograms = List.map (fun (_,_,_,id) -> counts id) es in
        let distinct = List.sort_uniq Stdlib.compare histograms in
        (List.length distinct > 1,
         List.length distinct - 1,
         Printf.sprintf "secondary=density_counts distinct=%d" (List.length distinct))
      | RankDensityThenVars ->
        let vars = List.map (fun (_,_,v,_) -> v) es in
        let min_v = List.fold_left min max_int vars in
        let max_v = List.fold_left max min_int vars in
        let delta = max_v - min_v in
        (delta > 0,
         delta,
         Printf.sprintf "secondary=var_uses min=%d max=%d delta=%d" min_v max_v delta)
      | RankVarsThenDensity ->
        let densities = List.map (fun (_,d,_,_) -> d) es in
        let sorted_densities = List.sort_uniq density_compare densities in
        let ranks = List.map density_rank densities in
        let min_r = List.fold_left min max_int ranks in
        let max_r = List.fold_left max min_int ranks in
        let delta = max_r - min_r in
        let best =
          match sorted_densities with
          | d :: _ -> density_to_string d
          | [] -> "none"
        in
        let worst =
          match List.rev sorted_densities with
          | d :: _ -> density_to_string d
          | [] -> "none"
        in
        (List.length sorted_densities > 1,
         delta,
         Printf.sprintf "secondary=density best=%s worst=%s distinct=%d rank_delta=%d"
           best worst (List.length sorted_densities) delta)
      | RankDensityOnly ->
        (false, 0, "secondary=none")
      | RankVarsOnly ->
        (false, 0, "secondary=none")
    in
    let groups =
      List.fold_left (fun acc e ->
        let k = primary_key e in
        match acc with
        | (k', es) :: rest when k = k' -> (k', e :: es) :: rest
        | _ -> (k, [e]) :: acc
      ) [] (List.sort (fun e e' -> compare (primary_key e) (primary_key e')) entries)
    in
    let tie_groups = List.filter (fun (_, es) -> List.length es > 1) groups in
    let choose2 n = n * (n - 1) / 2 in
    let tie_pairs = List.fold_left (fun acc (_, es) -> acc + choose2 (List.length es)) 0 tie_groups in
    let secondary_deciding_groups = List.filter (fun (_, es) -> let broken, _, _ = secondary_report es in broken) tie_groups in
    let unresolved_tie_groups = List.length tie_groups - List.length secondary_deciding_groups in
    let max_secondary_delta =
      List.fold_left (fun acc (_, es) ->
        let _, delta, _ = secondary_report es in
        max acc delta) 0 tie_groups
    in
    if tie_groups <> [] then begin
      Feedback.msg_notice
        (str (Printf.sprintf
          "[schedule-ranking] policy=%s derive=%s candidates=%d primary-tie-groups=%d primary-tie-pairs=%d secondary-deciding-groups=%d unresolved-tie-groups=%d max-secondary-delta=%d\n"
          (schedule_ranking_policy_to_string policy)
          (schedule_rank_derive_sort_to_string ds)
          (List.length entries)
          (List.length tie_groups)
          tie_pairs
          (List.length secondary_deciding_groups)
          unresolved_tie_groups
          max_secondary_delta));
      let limit = schedule_tie_report_limit () in
      let show_group (k, es) =
        let broken, _, secondary_summary = secondary_report es in
        let es = List.sort compare_entry es in
        let es = if limit = 0 then es else take_local limit es in
        Feedback.msg_notice (str (Printf.sprintf "[schedule-ranking] tied derive=%s primary=%s broken=%s %s showing=%d contender(s)\n"
          (schedule_rank_derive_sort_to_string ds)
          k (if broken then "yes" else "no") secondary_summary (List.length es)));
        List.iter (fun ((steps_ds, sort), density, num_var_uses, id) ->
          Feedback.msg_notice
            (str (Printf.sprintf "  id=%d density=%s var_uses=%d%s\n"
               id (density_to_string density) num_var_uses
               (if policy = RankDensityCountsThenVars then
                  " counts=" ^ ScheduleRanking.histogram_to_string (counts id)
                else ""))
             ++ str (schedule_with_densities_to_string (steps_ds, sort)))) es
      in
      List.iter show_group (if limit = 0 then tie_groups else take_local limit tie_groups)
    end
  end;
  sorted

let rec take n l =
  if n <= 0 then [] else
  match l with
  | [] -> []
  | x :: xs -> x :: take (n - 1) xs

(* The proof context is borrowed only while preparing one test. Global
   declarations may grow during that preparation, so refresh the base environment. *)
let schedule_locals = ref []
let schedule_universes = ref None

let schedule_env () =
  List.fold_right Environ.push_named !schedule_locals (Global.env ())

(* Merging the proof's universe context costs time proportional to its size,
   which grows with every test prepared in the proof. An evar map depends only
   on the environment's universe graph and that context, so reuse the merge
   until either changes. Helpers declared during preparation can already have
   added some of the proof's levels to the global graph; declare only the
   others, with all constraints. *)
let schedule_sigma_cache = ref None

let schedule_sigma env =
  match !schedule_universes with
  | None -> Evd.from_env env
  | Some universes ->
    let graph = Environ.universes env in
    match !schedule_sigma_cache with
    | Some (g, u, sigma) when g == graph && u == universes -> sigma
    | _ ->
      let context = UState.context_set universes in
      let levels = Univ.Level.Set.diff
        (Univ.ContextSet.levels context) (UGraph.domain graph) in
      let context = Univ.ContextSet.add_constraints
        (Univ.ContextSet.constraints context) (Univ.ContextSet.of_set levels) in
      let sigma = Evd.merge_context_set Evd.univ_rigid (Evd.from_env env) context in
      schedule_sigma_cache := Some (graph, universes, sigma);
      sigma

let with_schedule_context env sigma f =
  let global_ids = List.map Context.Named.Declaration.get_id
    (Environ.named_context (Global.env ())) in
  let previous = !schedule_locals in
  let previous_universes = !schedule_universes in
  let locals = List.filter (fun d ->
    not (List.mem (Context.Named.Declaration.get_id d) global_ids)) (Environ.named_context env) in
  let normalize c = EConstr.to_constr sigma (EConstr.of_constr c) in
  let locals = List.map (Context.Named.Declaration.map_constr normalize) locals in
  schedule_locals := locals;
  schedule_universes := Some (Evd.evar_universe_context sigma);
  Fun.protect ~finally:(fun () ->
    schedule_locals := previous; schedule_universes := previous_universes) f

let inline_schedule_definitions sigma term =
  List.fold_left (fun term -> function
    | Context.Named.Declaration.LocalDef (name, body, _) ->
        EConstr.Vars.replace_vars sigma [Context.binder_name name, EConstr.of_constr body] term
    | Context.Named.Declaration.LocalAssum _ -> term) term !schedule_locals

(* Keep lookup variables rigid after elaboration. In particular, type parameters
   are bindings, not unification holes that a concrete instance may specialize. *)
let schedule_inputs = ref []

let with_schedule_inputs inputs f =
  let previous = !schedule_inputs in
  schedule_inputs := inputs;
  Fun.protect ~finally:(fun () -> schedule_inputs := previous) f

let rec obligation_variables = function
  | DTyVar v | DTyParam v -> [v]
  | DTyCtr (_, args) | DCtr (_, args) -> List.concat_map obligation_variables args
  | DApp (head, args) -> List.concat_map obligation_variables (head :: args)
  | DNot p -> obligation_variables p
  | DHole -> []
  | _ -> CErrors.user_err (str "QuickChick cannot infer a dependency containing a binder.")

let distinct_variables xs =
  List.fold_left (fun acc v -> if List.mem v acc then acc else acc @ [v]) [] xs

let schedule_obligation relation outputs ds constrained =
  let open NewGenericLib in
  let relation = match relation with DNot p when ds = D_Check -> p | p -> p in
  let term = product_free_rocq_type_to_mexp relation in
  let class_name, args = match ds, constrained with
  | D_Check, _ -> "QuickChick.Decidability.DecOpt", [term]
  | D_Gen, false -> "QuickChick.Classes.GenSized", [term]
  | D_Enum, false -> "QuickChick.Classes.EnumSized", [term]
  | (D_Gen | D_Enum), true ->
      let pattern, annotation = match outputs with
      | [] -> PWild, Some (MConst "Coq.Init.Datatypes.unit")
      | v :: vs -> List.fold_left (fun p v ->
          PCtr (constructor_of_string "Coq.Init.Datatypes.pair", [PWild; PWild; p; PVar v])) (PVar v) vs, None in
      (if ds = D_Gen then "QuickChick.DependentClasses.GenSizedSuchThat"
       else "QuickChick.DependentClasses.EnumSizedSuchThat"),
      [MHole; MFun ([pattern, annotation], term)]
  | D_Thm, _ -> assert false in
  MTyCtr (ty_ctr_of_string class_name, args)

let elaborate_schedule_expression variables outputs ds expression =
  let env = schedule_env () in
  let in_env v = List.exists (fun d -> Names.Id.equal v
    (Context.Named.Declaration.get_id d)) (Environ.named_context env) in
  let inputs = List.filter (fun (v, _) -> not (List.mem v outputs)) !schedule_inputs in
  let bound = List.map fst inputs in
  let vars = distinct_variables variables |> List.filter (fun v ->
    not (in_env v || List.mem v outputs || List.mem v bound)) in
  let binders = inputs @ List.map (fun v -> v, MHole) vars in
  let expression = mexp_to_constr_expr
    (MFun (List.map (fun (v,t) -> NewGenericLib.PVar v, Some t) binders, expression)) ds in
  let expression = match expression.CAst.v with
    | Constrexpr.CLambdaN (binders, body) -> CAst.make (Constrexpr.CProdN (binders, body))
    | _ -> expression in
  Error.msg_debug (str "Instance obligation: " ++ str (constr_expr_to_string expression));
  let sigma, goal = Constrintern.interp_constr_evars env (schedule_sigma env) expression in
  let rec introduce env names goal =
    match EConstr.kind sigma goal with
    | Constr.Prod (name, ty, body) ->
        if Evarutil.has_undefined_evars sigma ty then
          CErrors.user_err (str "QuickChick could not determine a dependency argument's type.");
        let original = match Context.binder_name name with Names.Name id -> id | _ -> make_up_name_str "qc_arg" in
        let occupied = List.exists (fun d -> Names.Id.equal original
          (Context.Named.Declaration.get_id d)) (Environ.named_context env) in
        let id = if occupied then make_up_name_str "qc_bound" else original in
        let decl = Context.Named.Declaration.LocalAssum
          (Context.make_annot id Sorts.Relevant, EConstr.to_constr sigma ty) in
        introduce (Environ.push_named decl env) ((original, id) :: names)
          (EConstr.Vars.subst1 (EConstr.mkVar id) body)
    | _ -> env, sigma, goal, names in
  introduce env [] goal

let elaborate_obligation relation outputs ds constrained =
  elaborate_schedule_expression (obligation_variables relation) outputs ds
    (schedule_obligation relation outputs ds constrained)

let resolve_schedule_obligation env sigma goal =
  try Some (Typeclasses.resolve_one_typeclass env sigma goal)
  with Not_found ->
    let bounded = match Goptions.get_option_value ["Typeclasses"; "Depth"] with
      | Some get -> (match get () with Goptions.IntValue (Some _) -> true | _ -> false)
      | None -> false in
    if bounded then CErrors.user_err (str
      "QuickChick could not resolve an instance with the current Typeclasses Depth limit. Increase or unset that limit before automatic derivation.");
    None

(* Find premises of applicable registered instances, preserving complete class
   applications. This is requirement discovery, not a replacement resolver:
   the resulting context is checked by Coq's resolver and used again at emission.
   Concrete missing instances are never turned into generic assumptions. *)
let instance_requirements ?(allow_root=false) env sigma goal names =
  let goal = Reductionops.nf_betaiotazeta env sigma goal in
  let allowed = List.map (fun (v,_) ->
    try List.assoc v names with Not_found -> v) !schedule_inputs in
  let abstract_types = List.filter_map (fun d ->
    let id = Context.Named.Declaration.get_id d in
    if List.mem id allowed && Constr.isSort (Context.Named.Declaration.get_type d)
    then Some id else None) (Environ.named_context env) in
  let variables sigma term =
    let ids = ref Names.Id.Set.empty in
    let rec visit t =
      (match EConstr.kind sigma t with Constr.Var id -> ids := Names.Id.Set.add id !ids | _ -> ());
      EConstr.iter sigma visit t in
    visit term; Names.Id.Set.elements !ids in
  let can_abstract sigma ty =
    not (Evarutil.has_undefined_evars sigma ty) &&
    let vars = variables sigma ty in
    List.exists (fun v -> List.mem v abstract_types) vars &&
    List.for_all (fun v -> List.mem v allowed) vars &&
    (* Missing checkers are derivation work, not assumptions about propositions.
       Type requirements may still contain fixed term indices, e.g. C (vec A n). *)
    let (_, args) = Typeclasses.dest_class_app env sigma ty in
    List.for_all (fun arg ->
      let sigma, arg_type = Typing.type_of env sigma (EConstr.of_constr arg) in
      not (Constr.is_Prop (EConstr.to_constr sigma
        (Reductionops.whd_all env sigma arg_type)))) args in
  let rec discover allow_abstract seen sigma goal =
    match resolve_schedule_obligation env sigma goal with
    | Some (sigma, _) -> Some (sigma, [])
    | None when List.exists (EConstr.eq_constr sigma goal) seen -> None
    | None ->
      let seen = goal :: seen in
      let ((cls, _), _) = Typeclasses.dest_class_app env sigma goal in
      let instances = Stdlib.Option.value ~default:[] (Typeclasses.instances cls.Typeclasses.cl_impl) in
      let priority i = Stdlib.Option.value ~default:1000 (Typeclasses.hint_priority i) in
      let instances = List.stable_sort (fun a b -> compare (priority a) (priority b)) instances in
      let rec candidates = function
        | [] -> if allow_abstract && can_abstract sigma goal then Some (sigma, [goal]) else None
        | inst :: rest ->
          let attempt =
            let sigma, head = Evd.fresh_global env sigma (Typeclasses.instance_impl inst) in
            let sigma, typ = Typing.type_of env sigma head in
            let rec apply sigma premises typ =
              match EConstr.kind sigma (Reductionops.whd_all env sigma typ) with
              | Constr.Prod (_, dom, body) ->
                let sigma, arg = Evarutil.new_evar env sigma dom in
                let premises = if Typeclasses.is_class_type sigma dom then dom :: premises else premises in
                apply sigma premises (EConstr.Vars.subst1 arg body)
              | _ -> sigma, List.rev premises, typ in
            let sigma, premises, conclusion = apply sigma [] typ in
            let unified = try Some (Evarconv.unify env sigma Conversion.CONV conclusion goal)
              with Pretype_errors.PretypeError _ -> None in
            match unified with
            | None -> None
            | Some sigma ->
              let rec solve sigma needed = function
                | [] -> Some (sigma, needed)
                | ty :: rest ->
                  let ty = Evarutil.nf_evar sigma ty in
                  if Evarutil.has_undefined_evars sigma ty then None else
                  match discover true seen sigma ty with
                  | None -> None
                  | Some (sigma, requirements) ->
                    solve sigma (needed @ requirements) rest in
              solve sigma [] premises in
          match attempt with
          | None -> candidates rest
          | Some (sigma, requirements) ->
            let candidate_env = List.fold_left (fun env ty ->
              Environ.push_named (Context.Named.Declaration.LocalAssum
                (Context.make_annot (make_up_name_str "qc_premise") Sorts.Relevant,
                 EConstr.to_constr sigma ty)) env) env requirements in
            (match resolve_schedule_obligation candidate_env sigma goal with
             | Some _ -> attempt | None -> candidates rest) in
      candidates instances in
  match discover allow_root [] sigma goal with
  | None -> None
  | Some (sigma, requirements) ->
    let requirements = List.fold_left (fun acc ty ->
      let ty = Evarutil.nf_evar sigma ty in
      if List.exists (EConstr.eq_constr sigma ty) acc then acc else acc @ [ty]) [] requirements in
    let env' = List.fold_left (fun env ty ->
      Environ.push_named (Context.Named.Declaration.LocalAssum
        (Context.make_annot (make_up_name_str "qc_requirement") Sorts.Relevant,
         EConstr.to_constr sigma ty)) env) env requirements in
    match resolve_schedule_obligation env' sigma goal with
    | None -> None
    | Some _ -> Some (List.map (fun ty ->
        let expression = Flags.without_option Constrextern.print_universes
          (Constrextern.extern_constr env sigma) ty in
        let original_names = List.fold_left (fun map (original, fresh) ->
          Names.Id.Map.add fresh original map) Names.Id.Map.empty names in
        MEscape (Constrexpr_ops.replace_vars_constr_expr original_names expression)) requirements)

(* The answer depends on the obligation, the scheduled inputs' types, the
   proof-local context and universes, the global environment and the instance
   database. Within a derivation the last two change only with a declaration;
   derivation entry points clear the cache for changes between commands. *)
let schedule_instance_cache = Hashtbl.create 256
let schedule_instance_cache_context = ref None

let clear_schedule_instance_cache () =
  Hashtbl.reset schedule_instance_cache;
  schedule_instance_cache_context := None

(* Candidate schedules name their variables afresh, so the same instance
   obligation recurs as alpha-variants. Key the cache on the obligation with
   each variable not bound in the proof environment replaced by the index of
   its first occurrence, across the inputs (in binding order), the relation
   and the outputs. A variable named like a referenced constant's short name
   could capture it when elaborated, so such a name is kept. Forms the key
   does not cover keep their exact key. *)
exception Opaque_obligation

let canonical_obligation_key bound relation outputs ds constrained inputs =
  let b = Buffer.create 256 in
  let add = Buffer.add_string b in
  let names = ref [] and next = ref 0 in
  let referenced = ref Names.Id.Set.empty in
  let var v =
    if bound v || Names.Id.Set.mem v !referenced then
      (add "E:"; add (Names.Id.to_string v); add " ")
    else begin
      let i = match List.find_opt (fun (w, _) -> Names.Id.equal v w) !names with
        | Some (_, i) -> i
        | None -> let i = !next in incr next; names := (v, i) :: !names; i in
      add "#"; add (string_of_int i); add " "
    end in
  let qualid q = add (Libnames.string_of_qualid q); add " " in
  let rec pat = function
    | NewGenericLib.PCtr (c, ps) -> add "(C "; qualid c; List.iter pat ps; add ")"
    | NewGenericLib.PVar v -> var v
    | NewGenericLib.PParam -> add "P "
    | NewGenericLib.PWild -> add "_ " in
  let rec constr = function
    | DArrow (a, c) -> add "(-> "; constr a; constr c; add ")"
    | DLambda (p, a, c) -> add "(L "; var p; constr a; constr c; add ")"
    | DProd ((v, a), c) -> add "(Pi "; var v; constr a; constr c; add ")"
    | DTyParam p -> add "(Tp "; var p; add ")"
    | DTyCtr (c, args) -> add "(T "; qualid c; List.iter constr args; add ")"
    | DCtr (c, args) -> add "(K "; qualid c; List.iter constr args; add ")"
    | DTyVar v -> add "(V "; var v; add ")"
    | DApp (h, args) -> add "(A "; constr h; List.iter constr args; add ")"
    | DMatch (scrutinee, branches) ->
      add "(M "; constr scrutinee;
      List.iter (fun (p, c) -> pat p; constr c) branches; add ")"
    | DNot p -> add "(N "; constr p; add ")"
    | DHole -> add "? " in
  (* Input types come from product_free_rocq_type_to_mexp. *)
  let rec ty = function
    | MArrow (a, c) -> add "(-> "; ty a; ty c; add ")"
    | MProd (binders, c) ->
      add "(Pi "; List.iter (fun (v, a) -> var v; ty a) binders; ty c; add ")"
    | MId v -> add "(V "; var v; add ")"
    | MTyCtr (c, args) -> add "(T "; qualid c; List.iter ty args; add ")"
    | MCtr (c, args) -> add "(K "; qualid c; List.iter ty args; add ")"
    | MApp (h, args) -> add "(A "; ty h; List.iter ty args; add ")"
    | MHole -> add "? "
    | _ -> raise Opaque_obligation in
  let rec refs_constr = function
    | DArrow (a, c) | DLambda (_, a, c) | DProd ((_, a), c) -> refs_constr a; refs_constr c
    | DTyCtr (q, args) | DCtr (q, args) -> refer q; List.iter refs_constr args
    | DApp (h, args) -> List.iter refs_constr (h :: args)
    | DMatch (scrutinee, branches) ->
      refs_constr scrutinee; List.iter (fun (p, c) -> refs_pat p; refs_constr c) branches
    | DNot p -> refs_constr p
    | DTyParam _ | DTyVar _ | DHole -> ()
  and refs_pat = function
    | NewGenericLib.PCtr (q, ps) -> refer q; List.iter refs_pat ps
    | NewGenericLib.(PVar _ | PParam | PWild) -> ()
  and refs_ty = function
    | MArrow (a, c) -> refs_ty a; refs_ty c
    | MProd (binders, c) -> List.iter (fun (_, a) -> refs_ty a) binders; refs_ty c
    | MTyCtr (q, args) | MCtr (q, args) -> refer q; List.iter refs_ty args
    | MApp (h, args) -> List.iter refs_ty (h :: args)
    | _ -> ()
  and refer q = referenced := Names.Id.Set.add (Libnames.qualid_basename q) !referenced in
  try
    refs_constr relation; List.iter (fun (_, t) -> refs_ty t) inputs;
    List.iter (fun (v, t) -> add "[in "; var v; ty t; add "]") inputs;
    add "|"; constr relation; add "|";
    List.iter var outputs;
    Some (Buffer.contents b, ds, constrained)
  with Opaque_obligation -> None

let schedule_instance_canonical_cache = Hashtbl.create 256
let schedule_instance_bound = ref (fun (_ : Names.Id.t) -> false)

let rec has_schedule_instance ?(cached = true) relation outputs ds constrained =
  let decide () =
    let env, sigma, goal, names = elaborate_obligation relation outputs ds constrained in
    match instance_requirements
        ~allow_root:(match relation with DTyParam _ -> true | _ -> false)
        env sigma goal names with Some _ -> true | None -> false in
  let check = Sys.getenv_opt "QC_CHECK_INSTANCE_CACHE" <> None in
  let report cached fresh =
    Feedback.msg_warning (str ("[instance-cache] stale answer for " ^
      rocq_constr_to_string relation ^ ": cached " ^ string_of_bool cached ^
      ", fresh " ^ string_of_bool fresh)) in
  let exact_key = (relation, outputs, ds, constrained, !schedule_inputs) in
  if not cached then begin
    let answer = decide () in
    (if check then match Hashtbl.find_opt schedule_instance_cache exact_key with
       | Some previous when previous <> answer -> report previous answer
       | _ -> ());
    answer
  end else
  let context = Global.env (), !schedule_locals, !schedule_universes in
  (match !schedule_instance_cache_context with
   | Some (env, locals, universes) when
       env == (let e, _, _ = context in e) &&
       locals == (let _, l, _ = context in l) &&
       universes == (let _, _, u = context in u) -> ()
   | _ ->
     Hashtbl.reset schedule_instance_cache;
     Hashtbl.reset schedule_instance_canonical_cache;
     let env = schedule_env () in
     let ids = List.fold_left (fun ids d ->
       Names.Id.Set.add (Context.Named.Declaration.get_id d) ids)
       Names.Id.Set.empty (Environ.named_context env) in
     schedule_instance_bound := (fun v -> Names.Id.Set.mem v ids);
     schedule_instance_cache_context := Some context);
  match Hashtbl.find_opt schedule_instance_cache exact_key with
  | Some answer -> answer
  | None ->
    let canonical = canonical_obligation_key !schedule_instance_bound
      relation outputs ds constrained !schedule_inputs in
    let answer = match Option.bind canonical (Hashtbl.find_opt schedule_instance_canonical_cache) with
      | Some answer ->
        (if check then let fresh = decide () in
           if fresh <> answer then report answer fresh);
        answer
      | None ->
        let answer = decide () in
        Option.iter (fun key -> Hashtbl.replace schedule_instance_canonical_cache key answer) canonical;
        answer in
    Hashtbl.add schedule_instance_cache exact_key answer;
    answer

(* A policy score may call a dependency SuppliedInstance only when the
   obligation resolves in the current context, without invented premises. *)
let has_supplied_schedule_instance relation outputs ds constrained =
  let env, sigma, goal, _ = elaborate_obligation relation outputs ds constrained in
  match resolve_schedule_obligation env sigma goal with
  | Some (sigma, _) -> not (Evd.has_undefined sigma)
  | None -> false

let has_theorem_generator ty =
  let expression = MTyCtr
    (ty_ctr_of_string "QuickChick.Classes.TheoremGen",
     [product_free_rocq_type_to_mexp ty]) in
  let env, sigma, goal, _ = elaborate_schedule_expression
    (obligation_variables ty) [] D_Thm expression in
  match resolve_schedule_obligation env sigma goal with
  | Some (sigma, _) -> not (Evd.has_undefined sigma)
  | None -> false

(* Prefix probes must not choose a dependency schedule or leave a provisional
   grade in the memo used to score completed constructor candidates. Nested
   probes would also rerun the experimental search for every dependency. *)
let score_pruning_suspended = ref false

let with_score_pruning_suspended f =
  let previous = !score_pruning_suspended in
  score_pruning_suspended := true;
  Fun.protect ~finally:(fun () -> score_pruning_suspended := previous) f

let with_temporary_density_state f =
  let saved_inductive = !density_inductive_memo in
  let saved_rule = !density_memo in
  let saved_relations = !rocq_relation_memo in
  let saved_uncertainty = !density_uncertainty_events in
  Fun.protect ~finally:(fun () ->
    density_inductive_memo := saved_inductive;
    density_memo := saved_rule;
    rocq_relation_memo := saved_relations;
    density_uncertainty_events := saved_uncertainty)
    (fun () -> with_score_pruning_suspended f)

(* A completed, cycle-independent dependency entry is determined by its key,
   so candidates may share it. Without sharing, every candidate re-derives
   every dependency, which multiplies along nested derivations. *)
let reuse_stable_entries () =
  match Sys.getenv_opt "QC_SCHEDULE_REUSE_STABLE" with
  | Some ("0" | "false" | "no") -> false
  | _ -> true

(* Scoring a candidate derives its dependencies in scratch memo state. Shared
   stable entries are visible to it and new ones are kept; everything else
   it derives is discarded. Rankings never manage memo state themselves. *)
let with_candidate_density_state f =
  with_temporary_density_state (fun () ->
    let reuse = reuse_stable_entries () in
    if reuse then density_inductive_memo := with_stable_entries !density_inductive_memo;
    let before = !density_inductive_memo in
    let result = f () in
    if reuse then collect_stable_entries before;
    result)

(* Each candidate of each independent hypothesis group is derived on its own
   by [derive] and scored by [score], which sees the schedule and its density
   annotation. A candidate whose dependencies cannot be derived scores [None]. *)
let score_group_candidates derive score groups =
  List.map (List.map (fun schedule ->
    try with_candidate_density_state (fun () -> score schedule (derive schedule))
    with Noninductive_dependency _ | Unavailable_mode _ -> None)) groups

let budget_key ind_name result_vars output_vars ds = {
  BudgetAwareScore.relation = ind_name;
  output_indices = filter_mapi (fun i (v, _) ->
    if List.mem v output_vars then Some i else None) result_vars;
  derive_sort = ds }

(* Finite pins are cached for the lifetime of one context. *)
let budget_context inputs = {
  BudgetAwareScore.input_vars = inputs;
  finite_pins = BudgetAwareScore.finite_pins_from_environment ();
  completed_dependency = budget_dependency_score }

(* QC_SCHEDULE_SELECTION_LOG=<file> appends one line per selected constructor
   schedule, for comparing rankings across runs. *)
let log_schedule_selection ind_name ctr result_vars output_vars ds opt schedule =
  match Sys.getenv_opt "QC_SCHEDULE_SELECTION_LOG" with
  | None | Some "" -> ()
  | Some file ->
    let key = budget_key ind_name result_vars output_vars ds in
    let line = Printf.sprintf "%s|%s|%s|%b|%s|%s\n"
      (ty_ctr_to_string ind_name)
      (String.concat "," (List.map string_of_int key.BudgetAwareScore.output_indices))
      (schedule_rank_derive_sort_to_string ds) opt
      (constructor_to_string (fst ctr))
      (String.concat " " (String.split_on_char '\n'
         (schedule_with_densities_to_string schedule))) in
    let channel = open_out_gen [Open_append; Open_creat] 0o644 file in
    Fun.protect ~finally:(fun () -> close_out channel)
      (fun () -> output_string channel line)

let schedule_group_mode () = match Sys.getenv_opt "QC_SCHEDULE_GROUPS" with
  | Some ("0" | "false" | "no") -> `Off
  | Some "verify" -> `Verify
  | _ -> `On

let rec schedule_density neutral_prelude_steps schedule : schedule_with_density =
  let fixed step ds = match fixed_step_density ds step with
    | Some grade -> grade
    | None -> assert false in
  let step_density (step : schedule_step) ds : rule_density =
    match step with
    | S_UC (_, SrcNonrec (DTyParam _), _) -> fixed step ds
    | S_UC (_, SrcNonrec ty, ps) ->
      (if ds <> D_Thm || ps <> PS_G || not (has_theorem_generator ty) then
         ignore (best_inductive_schedule_from_instance ty [] (producer_sort_to_derive_sort ps) false);
      fixed step ds)
    | S_Check (SrcNonrec ty, _) ->
      (ignore (best_inductive_schedule_from_instance ty [] D_Check true);
      fixed step ds)
    | S_ST (output_var_tys, SrcNonrec (DTyCtr (ind,args)), ps) -> 
      let output_vars = List.map fst output_var_tys in
      let rec is_output i = (function
        | DTyVar j -> List.mem j output_vars
        | DCtr (_, args) -> List.exists (is_output i) args
        | _ -> false) in
      let output_indices = filter_mapi (fun i arg -> if is_output i arg then Some i else None) args in
      if has_schedule_instance (DTyCtr (ind,args)) output_vars (producer_sort_to_derive_sort ps) true then
        (match ps with PS_G -> Partial | PS_E -> Checking)
      else snd (inductive_best_valid_schedule (ty_ctr_to_rocq_relation ind) output_indices (producer_sort_to_derive_sort ps) true)
    | S_ST (_, SrcNonrec _, _) -> failwith "is_schedule_valid: Nonrecursive source should have DTyCtr at toplevel" 
    | S_ST (_, SrcMutrec _, _)
    | S_UC (_,SrcMutrec _, _)
    | S_Check (SrcMutrec _, _) -> failwith "is_schedule_valid: Mutually recursive source should not be used at density calculation time, but inserted later."
    | S_ST (_, SrcDef _, _)
    | S_UC (_,SrcDef _, _)
    | S_Check (SrcDef _, _) -> failwith "is_schedule_valid: Defined source should not be used at density calculation time, but inserted later."
    | _ -> fixed step ds
  in

  let (steps, sort) = schedule in

  let ds = match sort with
    | TheoremSchedule (concl,true) -> 
      ignore (best_inductive_schedule_from_instance concl [] D_Check true);
      D_Thm
    | TheoremSchedule (concl,false) -> 
      failwith "is_schedule_valid: TheoremSchedule should have true flag because that means it has not been replaced with a definition"
    | ProducerSchedule (_,PS_E,_) -> D_Enum
    | ProducerSchedule (_,PS_G,_) -> D_Gen
    | CheckerSchedule -> D_Check in

  (* Recursive dependency discovery mutates memo tables. Evaluate the same
     multiset of steps in a fixed order, then restore execution order for the
     resulting schedule. Independent swaps must not change their scores merely
     because one dependency happened to be visited first. *)
  let indexed = List.mapi (fun i step -> i, step) steps in
  let scored =
    List.sort (fun (_, left) (_, right) -> Stdlib.compare left right) indexed
    |> List.map (fun (i, step) -> i, (step, step_density step ds))
    |> List.sort (fun (left, _) (right, _) -> Stdlib.compare left right)
    |> List.map snd in
  let step_densities =
    List.map (fun step -> (step, match ds with
      | D_Thm | D_Gen -> Total | D_Check | D_Enum -> Checking)) neutral_prelude_steps
    @ scored in
  (* Check for unifications and heuristics! *)

  

  (step_densities, sort)


