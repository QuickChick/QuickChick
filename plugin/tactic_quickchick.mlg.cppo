(* Coq 8.15 activates tactic grammar under the name Declare ML Module uses. *)
#if COQ_VERSION >= (8, 16, 0)
DECLARE PLUGIN "coq-quickchick.plugin"
#else
DECLARE PLUGIN "quickchick_plugin"
#endif

{
let merge_sound =
  let rec get_hyps (s : Evd.evar_map) (c : EConstr.constr) =
    if EConstr.isProd s c then
      let (x,t1,t2) = EConstr.destProd s c in
      (x,t1) :: get_hyps s t2
    else []
  in 
  Proofview.Goal.enter begin fun gl ->
    let c = Proofview.Goal.concl gl in
    let s = Proofview.Goal.sigma gl in
    let to_intro = get_hyps s c in
    let rec calc_ids acc opts =
      match opts with
      | [] -> begin match acc with
              | to_ind::rest -> (to_ind, List.rev acc)
              | _ -> failwith "No product/merge_sound"
              end
      | (nb,_) :: nbs ->
         begin match Context.binder_name nb with
         | Names.Name id -> calc_ids (id :: acc) nbs
         | Names.Anonymous -> calc_ids (Names.Id.of_string "H" :: acc) nbs
         end in
    match calc_ids [] to_intro with
    | (_to_induct, opts) ->
       Tactics.intros_using_then opts (fun ids ->
           Tacticals.tclTHENLIST
             [ Tacticals.onLastHyp Tactics.simplest_elim
             ; Tactics.intros 
         ])
  end;;

let remember_induct h =
  Proofview.Goal.enter begin fun gl ->
    let s = Proofview.Goal.sigma gl in
    let env = Proofview.Goal.env gl in
    let cn = EConstr.mkVar h in
    Tacticals.tclTYPEOFTHEN cn (fun evm ct -> 
        msg_debug (str "Here: " ++ Printer.pr_constr_env env s (EConstr.to_constr s ct) ++ fnl());
        let to_remember = 
          if EConstr.isApp s ct then begin
              let (ctr, cs) = EConstr.destApp s ct in
              let to_remember = ref [] in
              Array.iter (fun cx ->
                  if EConstr.isApp s cx then
                    to_remember := cx :: !to_remember
                  else if EConstr.isConstruct s cx then
                    to_remember := cx :: !to_remember
                  else msg_debug (str "All good" ++ fnl ())) cs;
              !to_remember
            end
          else failwith "Not App" in
        let eqpat = CAst.make @@ Namegen.IntroAnonymous in 
        let cl =
          { Locus.onhyps = None
          ; Locus.concl_occs = Locus.AllOccurrences } in 
        let rec do_remembers (pats : EConstr.constr list) =
          match pats with
          | [] ->
#if COQ_VERSION >= (8, 19, 0)
            Induction.induction false None cn None None
#else
            Tactics.induction false None cn None None
#endif
          | p :: ps ->
             Tacticals.tclTHEN
#if COQ_VERSION >= (8, 18, 0)             
                   (Tactics.letin_pat_tac false (Some (true, eqpat)) (Names.Name.Anonymous) (Some s, p) cl)
#else
                   (Tactics.letin_pat_tac false (Some (true, eqpat)) (Names.Name.Anonymous) (s, p) cl)
#endif                 
                   (do_remembers ps) in
        msg_debug (int (List.length to_remember) ++ fnl ());
        do_remembers to_remember
      )
    end 

open GenericLib
open RelationInfo
open ModeMemo
open ScheduleScoring
open ScheduleContext
open ScheduleSelection
open ScheduleDerivation

let quickchick_it size idx =
  Proofview.Goal.enter_one begin fun gl ->
    let c = Proofview.Goal.concl gl in
    let e = Proofview.Goal.env gl in
    let evd = Proofview.Goal.sigma gl in
    reject_abstract_types e evd c;
    
    let definitions = ref [] in
    let universes = ref Univ.ContextSet.empty in
    let prepare () = with_schedule_context e evd (fun () ->
    match GenericLib.parse_dependent_type (EConstr.to_constr evd c) with
    | Some dt -> 
      begin
        msg_debug (str (GenericLib.rocq_constr_to_string dt) ++ fnl ());
        let open GenericLib in 
        reset_mode_memo ();
        inductive_set := inductive_set_init;
        rocq_relation_memo := TyCtrMap.empty;

        let e' = Global.env () in

        (* Index 0 needs only the best schedule; other indices need the full ranking. *)
        let theorem_schedules = all_theorem_schedules ~best_only:(idx = 0) dt in

        let selected_schedule = 
          (match List.nth_opt theorem_schedules idx with
          | Some (schd, _, _, inductive_memo, grade_memo_after) ->
            mode_memo := inductive_memo;
            grade_memo := grade_memo_after;
            schd
          | None -> CErrors.user_err (str (Printf.sprintf
              "quickchick: schedule index %d was requested, but only %d theorem schedule%s available."
              idx (List.length theorem_schedules)
              (if List.length theorem_schedules = 1 then " is" else "s are")))) in

        Feedback.msg_notice (str "Theorem Schedule:\n" ++ str (schedule_to_string selected_schedule) ++ fnl ());

        (* Register theorem as a phony inductive schedule *)
        let phony_theorem_ind_schd = ("theorem", [], [],[selected_schedule,[],[],WDefault],[]) in
        mode_memo := InductiveScheduleKeyMap.add (ty_ctr_of_string "theorem", [], D_Thm, true) (ModeDone ((phony_theorem_ind_schd, Checking), true, None)) !mode_memo;

        mode_memo := InductiveScheduleKeyMap.remove (ty_ctr_of_string "eq", [], D_Check, true) !mode_memo;
        complete_stable_closures ();
        let dependents, inductive_dependency_map = collect_all_used_inductive_schd_names "theorem" in
        Error.msg_debug (str "Dependents: " ++ str (String.concat ", " dependents) ++ fnl ());
        let components = tarjan_schedules_by_name dependents inductive_dependency_map in

        let ind_schd_name = "theorem" in

        Error.msg_debug (str ("Components: " ^ string_of_int (List.length components)) ++ fnl ());
        let schedules_pieces = inductive_schedules_to_def_constr_exprs components ind_schd_name in

        Feedback.msg_notice (str "Pieces: " ++ fnl ());
        List.iter (List.iter (fun (name, constr) -> Error.msg_debug (str (var_to_string name ^ ": ") ++ str (constr_expr_to_string constr) ++ fnl ()))) schedules_pieces;

        let theorem_constr = 
          begin match List.find_opt (function [(name, _)] -> name = var_of_string "theorem" | _ -> false) schedules_pieces with
          | Some [(_, constr)] -> constr
          | None -> failwith "quickchick_it: Could not find theorem in schedules pieces"
          end in

        define_schedule_components ~local:true components schedules_pieces;

        defined_set := VarSet.empty;

        let c_theorem = theorem_constr in
        let updated_env = schedule_env () in
        let updated_evd = schedule_sigma updated_env in
        let rec int_to_num i = 
          if i = 0 then c_zero
          else c_succ (int_to_num (i - 1))
        in
        msg_debug (str "Running QuickCheck" ++ fnl ());
        let size_thm =
          begin match size with
          | Some s -> c_app ~explicit:false c_theorem [int_to_num s]
          | None -> c_sized c_theorem
          end  in 
        (* Feedback.msg_notice (str "added size" ++ fnl ()); *)
        let (run_evd, to_run) =
          Constrintern.interp_constr_evars updated_env updated_evd
            (c_show (c_quickCheck size_thm)) in
        let to_run = inline_schedule_definitions run_evd to_run in
        #if COQ_VERSION >= (8, 20, 0)
          (* FRAGILE probably won't be allowed in the future? *)
          let opaque_access = Library.indirect_accessor[@@warning "-3"] in
          QuickChick.define_and_run ~opaque_access to_run updated_env run_evd;
  #else
          QuickChick.define_and_run to_run updated_env run_evd;
  #endif
        Tacticals.tclIDTAC
        (* end  *)
      end
    | None -> failwith "Failed to Parse type") in
    let previous = !proof_definitions in
    let sigma, definitions = Vernacstate.System.protect (fun () ->
      Fun.protect ~finally:(fun () -> proof_definitions := previous) (fun () ->
        proof_definitions := Some (definitions, universes);
        ignore (with_schedule_errors prepare);
        let env = Global.env () in
        let constants = List.filter_map (fun (_, reference) -> match reference with
          | Names.GlobRef.ConstRef c -> Some c | _ -> None) !definitions in
        (* Expand only this preparation's constants, including dependencies.
           Local lets then carry no references to discarded global declarations. *)
        let rec expand term = match Constr.kind term with
          | Constr.Const (c, u) when List.exists (Names.Constant.CanOrd.equal c) constants ->
              expand (Environ.constant_value_in env (c, u))
          | _ -> Constr.map expand term in
        let new_levels = Univ.Level.Set.diff
          (Univ.ContextSet.levels !universes) (UGraph.domain (Evd.universes evd)) in
        let universe_context = Univ.ContextSet.add_constraints
          (Univ.ContextSet.constraints !universes) (Univ.ContextSet.of_set new_levels) in
        List.fold_left (fun (sigma, acc) (name, reference) ->
          let sigma, term = Evd.fresh_global env sigma reference in
          let body = expand (EConstr.to_constr sigma term) in
          sigma, acc @ [name, EConstr.of_constr body])
          (Compat.merge_context_set evd universe_context, [])
          (List.rev !definitions))) () in
    Proofview.tclTHEN (Proofview.Unsafe.tclEVARS sigma)
      (List.fold_left (fun tactic (name, body) ->
        Proofview.tclTHEN tactic (Tactics.pose_tac (Names.Name name) body))
        Tacticals.tclIDTAC definitions)
  end

(*This tactic uses the quickchick_it tactic to run all possible indices with size None, capturing the Message output and putting it into a file in the 
current directory*)

(* This tactic uses the quickchick_it tactic to run all possible indices with size None,
   capturing the Message output and putting it into a file in the current directory *)

   open Proofview.Notations
   open Proofview
   open Feedback

let capture_output tac : unit Proofview.tactic =
  let file = open_out_gen [Open_creat; Open_text; Open_append] 0o666 "quickchick_run_output.txt" in

  let feedback_hook fb =
    match fb.contents with
#if COQ_VERSION >= (9, 0, 0)
    | Feedback.Message (_lvl, _, _, ppcmds) ->
#else
    | Feedback.Message (_lvl, _, ppcmds) ->
#endif
        let s = Pp.string_of_ppcmds ppcmds in
        output_string file (s ^ "\n"); flush file
    | _ -> () 
    in
  
  let id = Feedback.add_feeder feedback_hook in
  output_string file "OUTSTART:::\n";
  ignore id;
  tac >>= fun () ->
  output_string file "OUTEND:::\n";
  Feedback.del_feeder id;
  close_out file;
  Proofview.tclUNIT ()

let try_all_quickchick_schedules : unit Proofview.tactic =
   (* Storage for captured messages *)
   let captured_output = ref [] in
   

    let feedback_hook fb =
      match fb.contents with
  #if COQ_VERSION >= (9, 0, 0)
    | Feedback.Message (_lvl, _, _, ppcmds) ->
#else
    | Feedback.Message (_lvl, _, ppcmds) ->
#endif
          let s = Pp.string_of_ppcmds ppcmds in
          (*Print captured message to file*)

          captured_output := s :: !captured_output
      | _ -> () in
    

    let run_all_quickchick_it (max_index : int) : unit Proofview.tactic =
      (let id = Feedback.add_feeder feedback_hook in
    
      let rec loop i =
        if i > max_index then tclUNIT ()
        else
          (* Call the existing tactic here *)
          quickchick_it None i >>= fun () ->
          (* Capture output *)
          loop (i + 1)
      in
    
      loop 0 >>= fun () ->
      Feedback.del_feeder id; 
      (
        let oc = open_out "quickchick_run_output.txt" in
        List.iter (fun s -> output_string oc (s ^ "\n")) (List.rev !captured_output);
        close_out oc
      ); 
      Proofview.tclUNIT ())
      in

    run_all_quickchick_it 48 (* Adjust the max index as needed *)
 
}
TACTIC EXTEND quickchick
  | ["quickchick" int_list(ois)] -> { 
    match ois with
    | sz :: idx :: _ -> quickchick_it (Some sz) idx
    | x :: _ -> quickchick_it (Some x) 0
    | [] -> quickchick_it None 0}
END

TACTIC EXTEND quickchick_idx
  | ["quickchick_idx" int(idx)] -> { quickchick_it None idx }
END

TACTIC EXTEND try_all_quickchick_schedules
  | ["try_all_quickchick_schedules"] -> { try_all_quickchick_schedules }
END

TACTIC EXTEND capture_output 
  | ["capture_output" tactic(tac)] -> { 
    capture_output (Tacinterp.tactic_of_value (default_ist ()) tac) }
END

TACTIC EXTEND schedules 
  | ["schedules"] -> { schedules }
END

TACTIC EXTEND theorem_dependencies
  | ["theorem_dependencies"] -> { theorem_dependencies }
END

TACTIC EXTEND valid_schedules
  | ["valid_schedules"] -> { valid_schedules }
END

VERNAC COMMAND EXTEND Print CLASSIFIED AS SIDEFF
 | ["Print" "Typeclasses" "for" ident(ind)] ->
    { let ind' = Libnames.qualid_of_ident ind in 
      ignore (GenericLib.find_typeclass_bindings ind') }
END

(*type rocq_relation
  = ty_ctr        (* The name of the relation (e.g. IsSorted) *)
  * ty_param list (* The list of type parameters (e.g. "t" in IsSorted) *)
  * rocq_ctr list (* A list of constructors. Each constructor is a pair (name, type) *)
  * rocq_constr   (* The type of the overall relation (e.g. "list t -> Prop") *)*)

VERNAC COMMAND EXTEND DeriveSchedules CLASSIFIED AS SIDEFF
   | ["Derive" "Schedules" constr(ind) int_list(ois) "consnum" int(ctr_idx) "derive" string(ds)] ->
    { match GenericLib.ind_reference_to_rocq_relations ind with
    | Some (idx, rs) -> 
      let open GenericLib in
      let (ind_name, params, constructors, result_typ) = List.nth rs idx in

      (* Feedback.msg_notice (str "Inductive name: " 
                        ++ str (ty_ctr_to_string ind_name)
                        ++ str "\n Parameters: "
                        ++ str (String.concat ", " (List.map ty_param_to_string params)) 
                        ++ str "\n Result Type: "
                        ++ str (rocq_constr_to_string result_typ) 
                        ++ str "\n Output indices: "
                        ++ str (String.concat ", " (List.map string_of_int ois)) 
                        ++ str ("\n Derive Sort: " ^ ds) 
                        ++ str "\n\n"); *)
      let ds_string = ds in 
      let ds = (match ds with
      | "Check" -> D_Check
      | "Gen" -> D_Gen
      | "Thm" -> D_Thm
      | "Enum" -> D_Enum
      | _ -> failwith ("Invalid derive sort " ^ ds)) in

      let rec get_result_vars = function
      | DProd ((v,t), b) ->
        let v = make_up_name_str ("v_" ^ var_to_string v) in
        (v,t) :: get_result_vars b
      | DArrow (t1, t2) ->
        let v = make_up_name_str "v" in
        (v,t1) :: get_result_vars t2
      | _ -> [] in

      let dtype = DTyCtr (ty_ctr_of_string "Type", []) in

      let result_vars = List.map (fun p -> (p, dtype)) params @ get_result_vars result_typ in

      let rec remake_result vars result = 
        match vars, result with
        | [], _ -> result
        | (v,t) :: rest, DProd  (_, t') 
        | (v,t) :: rest, DArrow (_, t') -> DProd ((v,t), remake_result rest t')
        | _ -> failwith "remake_result failed" in

      let (ctr, constructor) = List.nth constructors ctr_idx in

      let output_vars = List.map fst (List.filteri (fun i _ -> List.mem i ois) result_vars) in

      let scheds = UnifyQC.type_to_schedules ?select_groups:(grouped_selector ds) constructor (Some ind_name) (Some ctr) result_vars output_vars ds true in
      
      let rec take n l =
        if n <= 0 then [] else
        match l with
        | [] -> []
        | x :: xs -> x :: take (n - 1) xs in

      let rec drop n l =
        if n <= 0 then l else
        match l with
        | [] -> []
        | x :: xs -> drop (n - 1) xs in

      Feedback.msg_notice (str "Inductive name: " 
                        ++ str (ty_ctr_to_string ind_name) 
                        ++ str "\n Constructor Name: " 
                        ++ str (ty_ctr_to_string ctr)
                        ++ str "\n Parameters: "
                        ++ str (String.concat ", " (List.map ty_param_to_string params))
                        ++ str "\n Constructor Type: "
                        ++ str (GenericLib.rocq_constr_to_string constructor)
                        ++ str "\n Result Type: "
                        ++ str (GenericLib.rocq_constr_to_string (remake_result (drop (List.length params) result_vars) result_typ))
                        ++ str "\n Output indices: "
                        ++ str (String.concat ", " (List.map string_of_int ois)) 
                        ++ str ("\n Derive Sort: " ^ ds_string) 
                        ++ str "\n\n");

      List.iteri (fun i (sch,ms,eqs) -> Feedback.msg_notice (str (string_of_int i) 
                                                          ++ str ":\n" 
                                                          ++ str (UnifyQC.match_schedule_to_string sch ms eqs) 
                                                          ++ str "\nconstrexpr: \n"
                                                          ++ (UnifyQC.match_schedule_as_pp_constr_expr sch ms eqs ds)
                                                          ++ str "\n\n===================\n" 
                                                          ++ fnl ())) (take 300 scheds) 
    | None -> failwith "Failed to parse inductive type" 
    }
END

VERNAC COMMAND EXTEND DeriveValidSchedules CLASSIFIED AS SIDEFF
   | ["Derive" "Valid" "Schedules" constr(ind) int_list(ois) "consnum" int(ctr_idx) "derive" string(ds)] ->
    { match GenericLib.ind_reference_to_rocq_relations ind with
    | Some (idx, rs) -> 
      let open GenericLib in
      let (ind_name, params, constructors, result_typ) = List.nth rs idx in
      reset_mode_memo ();
      Feedback.msg_notice (str "Inductive name: " 
                        ++ str (ty_ctr_to_string ind_name)
                        ++ str "\n Parameters: "
                        ++ str (String.concat ", " (List.map ty_param_to_string params)) 
                        ++ str "\n Result Type: "
                        ++ str (rocq_constr_to_string result_typ) 
                        ++ str "\n Output indices: "
                        ++ str (String.concat ", " (List.map string_of_int ois))
                        ++ str ("\n Derive Sort: " ^ ds) 
                        ++ str "\n\n");

      let ds = (match ds with
      | "Check" -> D_Check
      | "Gen" -> D_Gen
      | "Thm" -> D_Thm
      | "Enum" -> D_Enum
      | _ -> failwith ("Invalid derive sort " ^ ds)) in

      let rec get_result_vars = function
      | DProd ((v,t), b) ->
        let v = make_up_name_str ("v_" ^ var_to_string v) in
        (v,t) :: get_result_vars b
      | DArrow (t1, t2) ->
        let v = make_up_name_str "v" in
        (v,t1) :: get_result_vars t2
      | _ -> [] in

      let result_vars = List.map (fun v -> (v,DHole)) params @ get_result_vars result_typ in

      let rec remake_result vars result = 
        match vars, result with
        | [], _ -> result
        | (v,t) :: rest, DProd  (_, t') 
        | (v,t) :: rest, DArrow (_, t') -> DProd ((v,t), remake_result rest t')
        | _ -> failwith ("remake_result failed on: " ^ rocq_constr_to_string result) in

      let (ctr, constructor) = List.nth constructors ctr_idx in

      let output_vars = List.map fst (List.filteri (fun i _ -> List.mem i ois) result_vars) in

      let rec take n l =
        if n <= 0 then [] else
        match l with
        | [] -> []
        | x :: xs -> x :: take (n - 1) xs in

      let rec drop n l =
        if n <= 0 then l else
        match l with
        | [] -> []
        | x :: xs -> drop (n - 1) xs in

      Feedback.msg_notice (str "Inductive name: " 
                        ++ str (ty_ctr_to_string ind_name) 
                        ++ str "\n Constructor Name: " 
                        ++ str (ty_ctr_to_string ctr)
                        ++ str "\n Parameters: "
                        ++ str (String.concat ", " (List.map ty_param_to_string params))
                        ++ str "\n Constructor Type: "
                        ++ str (GenericLib.rocq_constr_to_string constructor)
                        ++ str "\n Result Type: "
                        ++ str (GenericLib.rocq_constr_to_string (remake_result (drop (List.length params) result_vars) result_typ))
                        ++ str "\n Output indices: "
                        ++ str (String.concat ", " (List.map string_of_int ois)) 
                        ++ str "\n\n");

      grade_memo := RelationInstMap.empty;
      clear_inductive_name_cache ();
      clear_schedule_instance_cache ();
      Feedback.msg_notice (str "Printing all bindings" ++ fnl ());
      let schedules_w_densities =
        match Sys.getenv_opt "QC_SCHEDULE_SCORE_PRUNING" with
        | Some ("1" | "true" | "yes" | "verify" | "baseline") ->
          (fun (_, scored, _) -> scored) (constructor_valid_schedules ind_name (ctr, constructor)
            result_vars output_vars ds true)
          |> List.map (fun (i, scored, _, _) -> i, scored)
          |> take 300
        | _ ->
          let scheds = UnifyQC.type_to_schedules ?select_groups:(grouped_selector ds)
            constructor (Some ind_name) (Some ctr) result_vars output_vars ds true in
          let schedules = take 300 scheds in
          let schedules' = List.map (fun ((steps, sort), ms, eqs) ->
            (List.map (fun (v,p) -> S_Match (v,p)) ms,
             (List.map check_eq eqs @ steps, sort))) schedules in
          List.mapi (fun i (ms_steps, schd) ->
            i, grade_schedule ms_steps schd) schedules' in
      let sorted = sort_schedules_by_density_and_var_uses schedules_w_densities ds in

      List.iter (fun ((steps_ds, sort), density, num_var_uses, id) ->

        Feedback.msg_notice (str (string_of_int id ^ ":\n" ) ++ fnl ());
        Feedback.msg_notice (str ("# var uses: " ^ string_of_int num_var_uses ^ "density:" ^ density_to_string density ^ "\n") ++
                            str (schedule_with_densities_to_string (steps_ds, sort) ^ "\n") ++                                           
                            str "\nconstrexpr: \n" ++ 
                            UnifyQC.match_schedule_as_pp_constr_expr (List.map fst steps_ds, sort) [] [] ds
                                                        ++ str "\n==============================================\n")) sorted

    | None -> failwith "Failed to parse inductive type" 
    }
END

      

VERNAC COMMAND EXTEND DeriveUsedInds CLASSIFIED AS SIDEFF
   | ["Derive" "Used" "Inds" constr(ind)] ->
    { match GenericLib.ind_reference_to_rocq_relations ind with
    | Some (idx, rs) ->
        let (ind_name, params, constructors, result_typ) = List.nth rs idx in
        (match get_inductive_name ind_name with
        | Some i -> print_type_names (List.map (fun (n,_,_,_) -> n) (seek_rocq_relations i))
        | None -> failwith "Failed to get inductive name")
    | None -> failwith "Failed to parse inductive type"  
    }
END

VERNAC COMMAND EXTEND DeriveDensity CLASSIFIED AS SIDEFF
   | ["Derive" "Density" constr(ind) int_list(ois) "derive" string(ds)] ->
    { match GenericLib.ind_reference_to_rocq_relations ind with
    | Some (idx, rs) ->
      reset_mode_memo ();
      inductive_set := inductive_set_init;
      rocq_relation_memo := TyCtrMap.empty;
      (* inductive_dependency_map := StringMap.empty; *)
      let (ind_name, params, constructors, result_typ) = List.nth rs idx in
      let ds = (match ds with
      | "Check" -> D_Check
      | "Gen" -> D_Gen
      | "Enum" -> D_Enum
      | _ -> failwith "Can only derive inductive schedules for Check, Gen, or Enum") in
      let (inductive_schedule, density) = inductive_best_valid_schedule (ind_name, params, constructors, result_typ) ois ds true in
      (* Feedback.msg_notice (str "Inductive Schedule:\n" ++ str (inductive_schedule_to_string inductive_schedule) ++ fnl ()); *)
      Feedback.msg_notice (str "Density: " ++ str (density_to_string density) ++ fnl ())

    | None -> failwith "Failed to parse inductive type" 
    }
END

VERNAC COMMAND EXTEND DeriveInductiveSchedule CLASSIFIED AS SIDEFF
   | ["Derive" "Inductive" "Schedule" constr(ind) int_list(ois) "derive" string(ds) "opt" string(opt)] ->
    { let ds = match ds with
      | "Check" -> D_Check | "Gen" -> D_Gen | "Enum" -> D_Enum
      | _ -> CErrors.user_err (str "Expected Check, Gen, or Enum") in
      let opt = match opt with
      | "true" -> true | "false" -> false
      | _ -> CErrors.user_err (str "Opt must be true or false") in
      derive_schedule ind ois ds opt }
END

TACTIC EXTEND merge_sound_core
  | ["merge_sound_core"] -> { merge_sound }
END

TACTIC EXTEND remember_induct
  | ["remember_induct" ident(h)] -> { remember_induct h }
END
