(** Compatibility spelling for pre-QCDerive source files.
    This enables a grammar that can conflict with Stdlib and other plugins.
    Prefer QCDerive in new code. *)
From QuickChick Require Export QuickChick.

#if COQ_VERSION >= (8, 16, 0)
Declare ML Module "coq-quickchick.legacy".
#else
Declare ML Module "quickchick_legacy_plugin".
#endif
